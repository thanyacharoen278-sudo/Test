local function CancelTween(t)
    if t then
        pcall(function()
            t:Cancel()
        end)
    end
end

local function ZeroVel()
    local h = HRP()
    if not h then
        return
    end
    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
        h.Velocity = Vector3.zero
    end)
end

local function NoCollide()
    pcall(function()
        local c = Char()
        if not c then
            return
        end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
        local hum = Hum()
        if hum then
            hum.AutoRotate = false
            hum.WalkSpeed = 0
            hum.JumpPower = 0
        end
    end)
end

local function GetLevel()
    local lv = 0
    pcall(function()
        local d = LP:FindFirstChild("Data") or LP:FindFirstChild("PlayerData")
        if d then
            local l = d:FindFirstChild("Level")
            if l then
                lv = l.Value
            end
        end
    end)
    return lv
end

local function EquipTool(name)
    pcall(function()
        if type(name) \~= "string" or #name == 0 then
            return
        end
        local c = Char()
        local hum = Hum()
        local bag = LP:FindFirstChild("Backpack")
        if not c or not hum then
            return
        end
        local held = c:FindFirstChildOfClass("Tool")
        if held and held.Name == name then
            return
        end
        if held and bag then
            held.Parent = bag
        end
        local tool = bag and bag:FindFirstChild(name)
        if tool then
            hum:EquipTool(tool)
        end
    end)
end

local function ScanWeapons()
    WeaponList = {}
    pcall(function()
        local function add(folder)
            if not folder then
                return
            end
            for _, t in ipairs(folder:GetChildren()) do
                if t:IsA("Tool") then
                    table.insert(WeaponList, t.Name)
                end
            end
        end
        add(LP:FindFirstChild("Backpack"))
        add(Char())
    end)
    if #WeaponList == 0 then
        WeaponList = { "Combat" }
    end
    if WeaponIndex > #WeaponList then
        WeaponIndex = 1
    end
    SelectWeapon = WeaponList[WeaponIndex]
end

local function NextWeapon()
    ScanWeapons()
    WeaponIndex = WeaponIndex + 1
    if WeaponIndex > #WeaponList then
        WeaponIndex = 1
    end
    SelectWeapon = WeaponList[WeaponIndex]
    EquipTool(SelectWeapon)
    return SelectWeapon
end

local function RefreshWeapon()
    ScanWeapons()
    if _G.AutoEquip then
        EquipTool(SelectWeapon)
    end
end

local function AutoHaki()
    if not _G.AutoHaki then
        return
    end
    pcall(function()
        RS.Remotes.CommF_:InvokeServer("Buso")
    end)
end

local function TweenTo(cf, speed)
    local h = HRP()
    if not h then
        return
    end
    speed = speed or TWEEN_SPEED
    CancelTween(moveTween)
    local dist = (h.Position - cf.Position).Magnitude
    local t = math.clamp(dist / math.max(speed, 1), 0.2, 6)
    moveTween = TweenService:Create(
        h,
        TweenInfo.new(t, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        { CFrame = cf }
    )
    moveTween:Play()
end

local function FloatOn(mob)
    local h = HRP()
    if not h or not mob then
        return
    end
    local root = mob:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end
    local goalPos = root.Position + Vector3.new(0, FLOAT_HEIGHT, 0)
    local goal = CFrame.lookAt(goalPos, root.Position)
    if (h.Position - goalPos).Magnitude < 2.5 then
        h.CFrame = goal
        ZeroVel()
        NoCollide()
        return
    end
    CancelTween(floatTween)
    floatTween = TweenService:Create(
        h,
        TweenInfo.new(FLOAT_TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = goal }
    )
    floatTween:Play()
    ZeroVel()
    NoCollide()
end

