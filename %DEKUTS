local function AddTab(Name, Text, Order)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -20, 0, 48)
    Button.Position = UDim2.new(0, 10, 0, 20 + ((Order - 1) * 55))
    Button.BackgroundColor3 = Color3.fromRGB(20, 22, 29)
    Button.BorderSizePixel = 0
    Button.Text = Text
    Button.TextColor3 = Color3.fromRGB(170, 180, 200)
    Button.TextSize = 14
    Button.Font = Enum.Font.GothamMedium
    Button.Parent = Sidebar
    Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 8)
    Button.MouseButton1Click:Connect(function()
        for _, p in pairs(Pages) do
            p.Visible = false
        end
        if Pages[Name] then
            Pages[Name].Visible = true
        end
        for _, o in ipairs(Sidebar:GetChildren()) do
            if o:IsA("TextButton") then
                o.BackgroundColor3 = Color3.fromRGB(20, 22, 29)
                o.TextColor3 = Color3.fromRGB(170, 180, 200)
            end
        end
        Button.BackgroundColor3 = Color3.fromRGB(25, 70, 130)
        Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    return Button
end

