local function BringSame(name, center)
    if not _G.BringMob then return end
    if not center then return end
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return end
    local i = 0
    for _, mob in ipairs(folder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            local match = true
            if type(name) == "string" and #name > 0 then
                match = string.find(string.lower(mob.Name), string.lower(name), 1, true) \~= nil
            end
            if match then
                local d = (root.Position - center).Magnitude
                if d <= BRING_RANGE then
                    i = i + 1
                    local offset = Vector3.new((i % 5) - 2, 0, math.floor(i / 5) % 5 - 2) * 1.2
                    pcall(function()
                        root.CFrame = CFrame.new(center + offset)
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.CanCollide = false
                    end)
                end
            end
        end
    end
end

