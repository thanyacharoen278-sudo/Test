task.spawn(function()
    while true do
        if _G.AutoRaid then
            SetFarmMode(true)
            pcall(function()
                DoHakiOnce()
                KeepEquip()
                local islandCF = RaidIslands[raidIslandIndex]
                if not islandCF then return end
                local h = HRP()
                if not h then return end
                if not raidArrived then
                    if (h.Position - islandCF.Position).Magnitude > ARRIVE_DIST then
                        TweenTo(islandCF * CFrame.new(0, 8, 0), RAID_TWEEN_SPEED)
                        return
                    end
                    raidArrived = true
                    raidNoMobTimer = 0
                    farmAnchor = islandCF.Position
                end
                local mob = FindRaidMob()
                if mob then
                    raidNoMobTimer = 0
                    FarmAt(mob, nil)
                else
                    StayOnRaidIsland(islandCF)
                    raidNoMobTimer = raidNoMobTimer + math.max(FAST_DELAY, 0.05)
                    if raidNoMobTimer >= RAID_NO_MOB_WAIT then
                        if raidIslandIndex < #RaidIslands then
                            GoNextRaidIsland()
                        else
                            raidNoMobTimer = 0
                        end
                    end
                end
            end)
            task.wait(FAST_DELAY)
        else
            task.wait(0.1)
        end
    end
end)

