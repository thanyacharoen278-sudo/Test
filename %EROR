local function CheckLevel()
    local row = GetQuestByLevel(GetLevel())
    if not row then
        Ms, NameQuest, QuestLv, NameMon = "", "", 1, ""
        CFrameQ, CFrameMon = CFrame.new(), CFrame.new()
        return
    end
    Ms = row.Ms
    NameQuest = row.NameQuest
    QuestLv = row.QuestLv
    NameMon = row.NameMon
    CFrameQ = row.CFrameQ
    CFrameMon = row.CFrameMon
end

local function HasQuest()
    local ok = false
    pcall(function()
        local gui = LP.PlayerGui:FindFirstChild("Main")
        local q = gui and gui:FindFirstChild("Quest")
        if q and q.Visible then ok = true end
    end)
    return ok
end

local function TakeQuest()
    pcall(function()
        if type(NameQuest) \~= "string" or #NameQuest == 0 then return end
        local h = HRP()
        if h and CFrameQ then
            if (h.Position - CFrameQ.Position).Magnitude > QUEST_ARRIVE then
                TweenTo(CFrameQ * CFrame.new(0, 5, 0), TWEEN_SPEED)
                return
            end
        end
        RS.Remotes.CommF_:InvokeServer("StartQuest", NameQuest, QuestLv)
    end)
end

local function EnsureQuest()
    if not _G.AutoQuest then return true end
    CheckLevel()
    if type(NameQuest) == "string" and #NameQuest > 0 then
        if not HasQuest() then
            TakeQuest()
            return false
        end
    end
    return true
end

