local function CancelTween(t)
    if t then pcall(function() t:Cancel() end) end
end

local function ZeroVel()
    local h = HRP()
    if not h then return end
    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
        h.Velocity = Vector3.zero
    end)
end

local function SetFarmMode(on)
    farmingActive = on
    local hum = Hum()
    if not hum then return end
    if on then
        hum.AutoRotate = false
        hum.WalkSpeed = 0
        hum.JumpPower = 0
    else
        hum.AutoRotate = true
        hum.WalkSpeed = 16
        hum.JumpPower = 50
        pcall(function()
            local c = Char()
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = true end
                end
            end
        end)
        CancelTween(floatTween)
        CancelTween(moveTween)
        farmAnchor = nil
        ZeroVel()
    end
end

local function NoCollide()
    if not farmingActive then return end
    pcall(function()
        local c = Char()
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
        local hum = Hum()
        if hum then
            hum.AutoRotate = false
            hum.WalkSpeed = 0
            hum.JumpPower = 0
        end
    end)
end

local function GetLevel()
    local lv = 0
    pcall(function()
        local d = LP:FindFirstChild("Data") or LP:FindFirstChild("PlayerData")
        if d then
            local l = d:FindFirstChild("Level")
            if l then lv = l.Value end
        end
    end)
    return lv
end

local function EquipTool(name)
    pcall(function()
        if type(name) \~= "string" or #name == 0 then return end
        local c, hum, bag = Char(), Hum(), LP:FindFirstChild("Backpack")
        if not c or not hum then return end
        local held = c:FindFirstChildOfClass("Tool")
        if held and held.Name == name then return end
        if held and bag then held.Parent = bag end
        local tool = bag and bag:FindFirstChild(name)
        if tool then hum:EquipTool(tool) end
    end)
end

local function ScanWeapons()
    WeaponList = {}
    pcall(function()
        local function add(folder)
            if not folder then return end
            for _, t in ipairs(folder:GetChildren()) do
                if t:IsA("Tool") then table.insert(WeaponList, t.Name) end
            end
        end
        add(LP:FindFirstChild("Backpack"))
        add(Char())
    end)
    if #WeaponList == 0 then WeaponList = { "Combat" } end
    if WeaponIndex > #WeaponList then WeaponIndex = 1 end
    if type(SelectWeapon) == "string" and #SelectWeapon > 0 then
        for i, n in ipairs(WeaponList) do
            if n == SelectWeapon then
                WeaponIndex = i
                break
            end
        end
    else
        SelectWeapon = WeaponList[WeaponIndex]
    end
end

local function NextWeapon()
    ScanWeapons()
    WeaponIndex = WeaponIndex + 1
    if WeaponIndex > #WeaponList then WeaponIndex = 1 end
    SelectWeapon = WeaponList[WeaponIndex]
    EquipTool(SelectWeapon)
    return SelectWeapon
end

local function KeepEquip()
    if not _G.AutoEquip then return end
    if type(SelectWeapon) == "string" and #SelectWeapon > 0 then
        EquipTool(SelectWeapon)
    end
end

local function DoHakiOnce()
    if not _G.AutoHaki then
        hakiDone = false
        return
    end
    if hakiDone then return end
    pcall(function()
        RS.Remotes.CommF_:InvokeServer("Buso")
        hakiDone = true
    end)
end

local function TweenTo(cf, speed)
    local h = HRP()
    if not h then return end
    speed = speed or TWEEN_SPEED
    CancelTween(moveTween)
    local dist = (h.Position - cf.Position).Magnitude
    local t = math.clamp(dist / math.max(speed, 1), 0.35, 10)
    moveTween = TweenService:Create(h, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = cf })
    moveTween:Play()
end

local function FloatStill(pos)
    local h = HRP()
    if not h or not pos then return end
    local goalPos = pos + Vector3.new(0, FLOAT_HEIGHT, 0)
    local goal = CFrame.new(goalPos)
    if (h.Position - goalPos).Magnitude < 2 then
        h.CFrame = goal
        ZeroVel()
        NoCollide()
        return
    end
    CancelTween(floatTween)
    floatTween = TweenService:Create(h, TweenInfo.new(FLOAT_TWEEN_TIME, Enum.EasingStyle.Quad), { CFrame = goal })
    floatTween:Play()
    ZeroVel()
    NoCollide()
end

local function FloatOn(mob)
    if not mob then return end
    local root = mob:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if not farmAnchor then
        farmAnchor = root.Position
    end
    FloatStill(farmAnchor)
end

