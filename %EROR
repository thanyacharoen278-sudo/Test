local function FarmAt(mob, monName)
    if not farmAnchor then
        local root = mob and mob:FindFirstChild("HumanoidRootPart")
        farmAnchor = root and root.Position or (HRP() and HRP().Position)
    end
    if farmAnchor then
        BringSame(monName, farmAnchor)
        FloatStill(farmAnchor)
        AttackAround()
    end
end

