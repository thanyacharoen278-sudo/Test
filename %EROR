local function NameMatch(mobName, want)
    if type(want) \~= "string" or #want == 0 then return true end
    if type(mobName) \~= "string" then return false end
    return string.find(string.lower(mobName), string.lower(want), 1, true) \~= nil
end

local function FindMob(name, range)
    range = range or DETECT_RANGE
    local h = HRP()
    if not h then return nil end
    local best, bestD = nil, range
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    for _, mob in ipairs(folder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 and NameMatch(mob.Name, name) then
            local d = (root.Position - h.Position).Magnitude
            if d < bestD then
                bestD = d
                best = mob
            end
        end
    end
    return best
end

local function FindNearMob()
    return FindMob(nil, 8000)
end

local function FindLevelMob()
    local h = HRP()
    if not h then return nil end
    if CFrameMon then
        if (h.Position - CFrameMon.Position).Magnitude > FARM_ARRIVE then
            farmAnchor = nil
            TweenTo(CFrameMon * CFrame.new(0, FLOAT_HEIGHT, 0), TWEEN_SPEED)
            return nil
        end
        if not farmAnchor then farmAnchor = CFrameMon.Position end
    end
    local mob = nil
    if type(NameMon) == "string" and #NameMon > 0 then
        mob = FindMob(NameMon, DETECT_RANGE)
    end
    if not mob then mob = FindNearMob() end
    return mob
end

local function FindSelectedMon()
    local h = HRP()
    if not h then return nil end
    local cf = GetMonCFrame(SelectMon)
    if cf then
        if (h.Position - cf.Position).Magnitude > FARM_ARRIVE then
            farmAnchor = nil
            TweenTo(cf * CFrame.new(0, FLOAT_HEIGHT, 0), TWEEN_SPEED)
            return nil
        end
        if not farmAnchor then farmAnchor = cf.Position end
    end
    return FindMob(SelectMon, DETECT_RANGE) or FindNearMob()
end

local function FindRaidMob()
    local islandCF = RaidIslands[raidIslandIndex]
    if not islandCF then return nil end
    local best, bestD = nil, RAID_ISLAND_RANGE
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    for _, mob in ipairs(folder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            local d = (root.Position - islandCF.Position).Magnitude
            if d < bestD then
                bestD = d
                best = mob
            end
        end
    end
    return best
end

local function StayOnRaidIsland(cf)
    local h = HRP()
    if not h or not cf then return end
    local goal = cf * CFrame.new(0, 8, 0)
    if (h.Position - goal.Position).Magnitude > 10 then
        TweenTo(goal, RAID_TWEEN_SPEED)
    else
        h.CFrame = goal
        ZeroVel()
    end
end

local function GoNextRaidIsland()
    if raidIslandIndex < #RaidIslands then
        raidIslandIndex = raidIslandIndex + 1
    end
    raidArrived = false
    raidNoMobTimer = 0
    farmAnchor = nil
end

