local function GetQuestByLevel(lv)
    for _, row in ipairs(QuestData) do
        if lv >= row.minLevel and lv <= row.maxLevel then
            return row
        end
    end
    return QuestData[#QuestData]
end

local function GetMonCFrame(name)
    if type(name) \~= "string" or #name == 0 then return nil end
    for _, row in ipairs(QuestData) do
        if row.NameMon == name or row.Ms == name then
            return row.CFrameMon
        end
    end
    return nil
end

