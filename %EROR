local function AddToggle(text, key, defaultOn)
    local on = defaultOn and true or false
    _G[key] = on
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -2, 0, 38)
    btn.BackgroundColor3 = on and Color3.fromRGB(30, 75, 150) or CARD
    btn.BorderSizePixel = 0
    btn.Text = "  " .. text .. (on and "  · ON" or "  · OFF")
    btn.TextColor3 = Color3.fromRGB(230, 235, 245)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = Scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn.MouseButton1Click:Connect(function()
        _G[key] = not _G[key]
        local v = _G[key]
        btn.Text = "  " .. text .. (v and "  · ON" or "  · OFF")
        btn.BackgroundColor3 = v and Color3.fromRGB(30, 75, 150) or CARD
        if key == "AutoRaid" and v then
            raidIslandIndex = 1
            raidArrived = false
            raidNoMobTimer = 0
        end
        if key == "AutoHaki" and v then
            hakiDone = false
        end
        if not AnyFarmOn() then
            SetFarmMode(false)
        end
        farmAnchor = nil
    end)
end

local function AddBtn(text, cb)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -2, 0, 38)
    btn.BackgroundColor3 = CARD
    btn.BorderSizePixel = 0
    btn.Text = "  " .. text
    btn.TextColor3 = Color3.fromRGB(230, 235, 245)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = Scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn.MouseButton1Click:Connect(function()
        if cb then cb(btn) end
    end)
    return btn
end

