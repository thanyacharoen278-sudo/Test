local ClipConn = nil
local BV = nil
local BG = nil

local function HRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Hum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function SetNoclip(on)
    if ClipConn then
        ClipConn:Disconnect()
        ClipConn = nil
    end
    if on then
        ClipConn = RunService.Stepped:Connect(function()
            local c = LP.Character
            if not c then return end
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                end
            end
        end)
    end
end

local function ClearBody()
    if BV then pcall(function() BV:Destroy() end) BV = nil end
    if BG then pcall(function() BG:Destroy() end) BG = nil end
end

local function EnsureBody()
    local h = HRP()
    if not h then return end
    ClearBody()
    BV = Instance.new("BodyVelocity")
    BV.Name = "DEKU_BV"
    BV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    BV.Velocity = Vector3.zero
    BV.Parent = h
    BG = Instance.new("BodyGyro")
    BG.Name = "DEKU_BG"
    BG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    BG.P = 3000
    BG.Parent = h
end

local function CancelTween()
    if farmTween then
        pcall(function() farmTween:Cancel() end)
        farmTween = nil
    end
end

-- Tween ช้าลง เสถียร (ไม่ดีด)
local function TweenTo(cf)
    local h = HRP()
    if not h then return end
    SetNoclip(true)
    EnsureBody()
    CancelTween()
    local dist = (h.Position - cf.Position).Magnitude
    local spd = math.clamp(tonumber(TweenSpeed) or 120, 40, 250)
    -- เวลาขั้นต่ำมากขึ้น กันวาร์ป
    local t = math.clamp(dist / spd, 0.2, 12)
    if dist < 8 then
        h.CFrame = cf
        if BV then BV.Velocity = Vector3.zero end
        h.AssemblyLinearVelocity = Vector3.zero
        return
    end
    farmTween = TweenService:Create(
        h,
        TweenInfo.new(t, Enum.EasingStyle.Linear),
        { CFrame = cf }
    )
    farmTween:Play()
    if BV then BV.Velocity = Vector3.zero end
end

-- ลอยนิ่งเหนือมอน (สูง 14 ศึก, ไม่กระตุก)
-- ลอยนิ่งบนหัวมอน (ความสูงปรับได้ด้วย FarmDistance ใกล้ๆ)
local FloatHeight = 10
local function FloatAt(pos)
    local h = HRP()
    if not h then return end
    SetNoclip(true)
    EnsureBody()
    local height = FloatHeight or 6
    local target = CFrame.new(pos.X, pos.Y + height, pos.Z)
    local dist = (h.Position - target.Position).Magnitude
    if dist > 40 then
        TweenTo(target)
    elseif dist > 4 then
        CancelTween()
        local t = math.clamp(dist / 35, 0.12, 0.7)
        farmTween = TweenService:Create(
            h,
            TweenInfo.new(t, Enum.EasingStyle.Linear),
            { CFrame = target }
        )
        farmTween:Play()
        if BV then BV.Velocity = Vector3.zero end
    else
        CancelTween()
        h.CFrame = target
        if BV then BV.Velocity = Vector3.zero end
        if BG then BG.CFrame = target end
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end
end

