local function StartAutoFarm()
    if FarmRunning then return end
    -- กันทับโหมดอื่น
    AutoNextIsland = false
    Auto_Law = false
    Auto_StartRaid = false
    FarmRunning = true
    AttackAlways = true
    SetNoclip(true)
    task.spawn(function()
        local questTries = 0
        while FarmRunning do
            pcall(function()
                CheckLevel()
                AutoHaki()
                if not GetEquippedTool() then
                    EquipMelee()
                end

                local h = HRP()
                if not h then return end

                -- รับเควส (ลองไม่เกิน 3 ครั้ง แล้วไปฟาร์มต่อ)
                if not HasQuest() and questTries < 3 then
                    local d = (h.Position - CFrameQ.Position).Magnitude
                    if d > 18 then
                        TweenTo(CFrameQ * CFrame.new(0, 6, 0))
                        task.wait(0.4)
                    else
                        CancelTween()
                        h.CFrame = CFrameQ * CFrame.new(0, 6, 0)
                        TakeQuest()
                        questTries = questTries + 1
                        task.wait(1.2)
                    end
                    -- ถ้ายังไม่มีเควสและลองครบแล้ว → ไปฟาร์มเลย
                    if not HasQuest() and questTries >= 3 then
                        -- ไปจุดมอน
                    elseif not HasQuest() then
                        return
                    end
                end

                if HasQuest() then
                    questTries = 0
                end

                -- หามอนตามเควสเป็นหลัก (ไม่ไปตีตัวผิด)
                local mob = FindMob(NameMon) or FindMob(Ms)
                if not mob then
                    local folder = workspace:FindFirstChild("Enemies")
                    local best, bestD = nil, 400
                    local key = string.lower(tostring(NameMon or Ms or ""))
                    if folder and key ~= "" then
                        for _, m in ipairs(folder:GetChildren()) do
                            local hum = m:FindFirstChildOfClass("Humanoid")
                            local root = m:FindFirstChild("HumanoidRootPart")
                            if hum and root and hum.Health > 0 then
                                local mn = string.lower(m.Name)
                                if string.find(mn, key, 1, true) then
                                    if key:find("captain") and mn:find("pirate") then
                                        -- ข้าม
                                    else
                                        local d = (root.Position - CFrameMon.Position).Magnitude
                                        if d < bestD then
                                            bestD = d
                                            best = m
                                        end
                                    end
                                end
                            end
                        end
                    end
                    mob = best
                end

                if mob then
                    local root = mob:FindFirstChild("HumanoidRootPart")
                    if root then
                        SoftenMob(mob)
                        FloatAt(root.Position)
                        AttackNoCoolDown()
                    end
                else
                    -- ไปจุดมอน รอสปอว์น
                    local d = (h.Position - CFrameMon.Position).Magnitude
                    if d > 30 then
                        TweenTo(CFrameMon * CFrame.new(0, 18, 0))
                    else
                        FloatAt(CFrameMon.Position)
                    end
                end
            end)
            task.wait(0.35)
        end
        CancelTween()
        ClearBody()
        SetNoclip(false)
    end)
end

local function StopAutoFarm()
    FarmRunning = false
    if not AutoNextIsland and not Auto_Law then
        AttackAlways = false
        ClearBody()
        SetNoclip(false)
    end
    CancelTween()
end


