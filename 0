        if o2 then o2:Destroy() end
    end)

    local logoGui = Instance.new("ScreenGui")
    logoGui.Name = "DEKUxHUB_Logo"
    logoGui.ResetOnSpawn = false
    logoGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    logoGui.DisplayOrder = 1000
    logoGui.IgnoreGuiInset = true
    pcall(function() logoGui.Parent = parent end)
    if not logoGui.Parent then logoGui.Parent = CoreGui end

    local btn = Instance.new("TextButton")
    btn.Name = "Logo"
    btn.Size = UDim2.fromOffset(50, 50)
    btn.Position = UDim2.new(0, 16, 0.45, 0)
    btn.BackgroundColor3 = Color3.fromRGB(12, 28, 58)
    btn.BorderSizePixel = 0
    btn.Text = "D"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 24
    btn.TextColor3 = Color3.fromRGB(90, 190, 255)
    btn.AutoButtonColor = true
    btn.ZIndex = 50
    btn.Parent = logoGui

    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 150, 255)
    stroke.Thickness = 2
    stroke.Parent = btn

    local uiOpen = true
    local drag, dStart, sPos = false, nil, nil
    local clickBlock = false

    local function setFluentVisible(vis)
        -- Fluent library minimize
        pcall(function()
            if Window and Window.Minimize then
                if not vis then Window:Minimize() end
            end
        end)
        pcall(function()
            if Fluent and Fluent.Options and Fluent.Minimize then
                Fluent:Minimize()
            end
        end)
        -- ScreenGui scan
        local function scan(root)
            if not root then return end
            for _, g in ipairs(root:GetChildren()) do
                if g:IsA("ScreenGui") and g.Name ~= "DEKUxHUB_Logo" then
                    local n = string.lower(g.Name)
                    if n:find("fluent") or n:find("dekux") or g:FindFirstChild("Main", true) then
                        g.Enabled = vis
                    end
                end
            end
        end
        scan(LP:FindFirstChild("PlayerGui"))
        pcall(function() scan(CoreGui) end)
        pcall(function() if gethui then scan(gethui()) end end)
    end

    btn.MouseButton1Click:Connect(function()
        if clickBlock then return end
        uiOpen = not uiOpen
        setFluentVisible(uiOpen)
        btn.TextTransparency = uiOpen and 0 or 0.4
        stroke.Color = uiOpen and Color3.fromRGB(60, 150, 255) or Color3.fromRGB(90, 90, 90)
    end)

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            drag = true
            clickBlock = false
            dStart = input.Position
            sPos = btn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    drag = false
                    task.delay(0.08, function() clickBlock = false end)
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not drag then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dStart
            if delta.Magnitude > 6 then clickBlock = true end
            btn.Position = UDim2.new(
                sPos.X.Scale, sPos.X.Offset + delta.X,
                sPos.Y.Scale, sPos.Y.Offset + delta.Y
            )
        end
    end)
end)

