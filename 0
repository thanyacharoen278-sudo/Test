local function FindMob(name)
    local folder = workspace:FindFirstChild("Enemies")
    if not folder or not name or name == "" then return nil end
    local h = HRP()
    local key = string.lower(tostring(name))
    key = key:gsub("%s*%[.-%]", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    local best, bestScore = nil, -1
    for _, mob in ipairs(folder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            local mn = string.lower(mob.Name)
            mn = mn:gsub("%s*%[.-%]", ""):gsub("%s+", " ")
            local match = false
            local score = 0
            if mn == key then
                match, score = true, 100
            elseif string.find(mn, key, 1, true) then
                match, score = true, 80
            elseif string.find(key, mn, 1, true) then
                match, score = true, 40
            end
            -- กันสับสน Galley Pirate กับ Galley Captain
            if match and string.find(key, "captain", 1, true) and string.find(mn, "pirate", 1, true) then
                match = false
            end
            if match and string.find(key, "pirate", 1, true) and string.find(mn, "captain", 1, true) then
                match = false
            end
            if match then
                local d = h and (root.Position - h.Position).Magnitude or 0
                score = score - math.min(d / 100, 20)
                if score > bestScore then
                    bestScore = score
                    best = mob
                end
            end
        end
    end
    return best
end

local function FindNearestMob(maxDist)
    maxDist = maxDist or 500
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    local h = HRP()
    if not h then return nil end
    local best, bestD = nil, maxDist
    for _, mob in ipairs(folder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            local d = (root.Position - h.Position).Magnitude
            if d < bestD then
                bestD = d
                best = mob
            end
        end
    end
    return best
end

local lastEquipTick = 0
local function EquipMelee()
    local c = LP.Character
    if not c then return end
    -- ถืออาวุธอยู่แล้ว ไม่ต้องสลับ
    if c:FindFirstChildOfClass("Tool") then return end
    -- กันเรียกถี่เกินไป
    if tick() - lastEquipTick < 1.5 then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local pick = nil
    -- prefer Combat / Melee
    for _, t in ipairs(LP.Backpack:GetChildren()) do
        if t:IsA("Tool") then
            local n = string.lower(t.Name)
            local tip = t.ToolTip
            if tip == "Melee" or n == "combat" or string.find(n, "godhuman")
                or string.find(n, "death step") or string.find(n, "electric")
                or string.find(n, "dragon") or string.find(n, "superhuman") then
                pick = t
                break
            end
        end
    end
    if not pick then
        for _, t in ipairs(LP.Backpack:GetChildren()) do
            if t:IsA("Tool") then
                pick = t
                break
            end
        end
    end
    if pick then
        lastEquipTick = tick()
        pcall(function() hum:EquipTool(pick) end)
    end
end

