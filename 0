local function RaidAttack()
    local h = HRP()
    if not h then return end
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    local range = tonumber(RaidRange) or 150
    local dmg = tonumber(RaidDamage) or 3000
    local pos = h.Position
    local list = {}
    local mainPart = nil

    for _, enemy in ipairs(enemies:GetChildren()) do
        local humanoid = enemy:FindFirstChildOfClass("Humanoid")
        local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
        if humanoid and enemyRoot and humanoid.Health > 0 then
            if (enemyRoot.Position - pos).Magnitude <= range then
                -- ดาเมจฝั่ง client (เกมที่อนุญาต)
                pcall(function()
                    humanoid:TakeDamage(dmg)
                end)
                pcall(function()
                    if humanoid.Health <= 1 or humanoid.Health <= humanoid.MaxHealth * 0.05 then
                        humanoid.Health = 0
                        humanoid:ChangeState(Enum.HumanoidStateType.Dead)
                        humanoid:TakeDamage(1e9)
                    end
                end)
                local part = enemy:FindFirstChild("Head")
                    or enemy:FindFirstChild("HumanoidRootPart")
                    or enemyRoot
                list[#list + 1] = { enemy, part }
                mainPart = mainPart or part
                pcall(function()
                    SoftenMob(enemy)
                end)
            end
        end
    end

    -- Blox Fruits: ส่ง Remote ให้เซิร์ฟคิดดาเมจจริง
    if mainPart and #list > 0 and ResolveNet and ResolveNet() then
        pcall(function()
            if not GetEquippedTool or not GetEquippedTool() then
                if EquipMelee then EquipMelee() end
            end
        end)
        pcall(function()
            RegisterAttack:FireServer(1e-9)
        end)
        pcall(function()
            RegisterHit:FireServer(mainPart, list)
        end)
        pcall(function()
            VU:CaptureController()
            VU:ClickButton1(Vector2.new())
        end)
    end
end

