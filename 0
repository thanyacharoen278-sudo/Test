local function SoftenMob(mob)
    if not mob then return end
    pcall(function()
        for _, p in ipairs(mob:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
        local root = mob:FindFirstChild("HumanoidRootPart")
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            pcall(function() hum.AutoRotate = false end)
            -- เลือดน้อย / ติด 0% → บังคับตาย
            if hum.Health <= 1 or hum.Health <= hum.MaxHealth * 0.05 then
                ForceKill(mob)
            end
        end
        local h = HRP()
        if root and h and hum and hum.Health > 0 then
            root.CFrame = CFrame.new(h.Position.X, h.Position.Y - 6, h.Position.Z)
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

function AttackNoCoolDown()
    local tool = GetEquippedTool()
    if not tool then
        EquipMelee()
        tool = GetEquippedTool()
        if not tool then return end
    end

    if not ResolveNet() then return end

    local list, mainPart = CollectTargets()
    if not mainPart or #list == 0 then return end

    -- กันมอนตีกลับ
    for i = 1, math.min(#list, 8) do
