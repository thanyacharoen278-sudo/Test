-- ค่าที่ผู้ใช้กำหนด (ผูกกับ Slider)
local AttackRange = 150   -- ระยะตี
-- AttackSpeed จาก UI: 5-50 → delay

local function GetEquippedTool()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Tool")
end

local function GetHitPart(mob)
    return mob:FindFirstChild("Head")
        or mob:FindFirstChild("UpperTorso")
        or mob:FindFirstChild("HumanoidRootPart")
        or mob:FindFirstChild("LeftLowerLeg")
        or mob:FindFirstChildWhichIsA("BasePart")
end

-- รวบเป้าในระยะที่เรากำหนด
local function CollectTargets()
    local list, mainPart, nearest = {}, nil, math.huge
    local h = HRP()
    if not h then return list, nil end
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return list, nil end
    local pos = h.Position
    local range = tonumber(AttackRange) or 150

    local prefer = (FarmRunning and NameMon and NameMon ~= "") and string.lower(NameMon) or nil
    local preferred, others = {}, {}

    for _, mob in ipairs(folder:GetChildren()) do
        if mob:IsA("Model") and mob ~= LP.Character and not mob:GetAttribute("IsBoat") then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local root = mob:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                local dist = (root.Position - pos).Magnitude
                if dist <= range then
                    local part = GetHitPart(mob)
                    if part then
                        local entry = { mob, part }
                        local mn = string.lower(mob.Name)
                        if prefer and string.find(mn, prefer, 1, true) then
                            preferred[#preferred + 1] = entry
                        else
                            others[#others + 1] = entry
                        end
                        if dist < nearest then
                            nearest = dist
                            mainPart = part
                        end
                    end
                end
            end
        end
    end
    for _, e in ipairs(preferred) do list[#list + 1] = e end
    for _, e in ipairs(others) do list[#list + 1] = e end
    if #preferred > 0 then mainPart = preferred[1][2] end
    return list, mainPart
end

