local function SetUIVisible(visible)
    if Config.UIAnimation then
        local goal = visible and {BackgroundTransparency = 0} or {BackgroundTransparency = 1}
        -- simple fade
        Main.Visible = true
        TweenService:Create(Main, TweenInfo.new(0.2), {
            Size = visible and Config.UISize or UDim2.fromOffset(Config.UISize.X.Offset * 0.9, Config.UISize.Y.Offset * 0.9)
