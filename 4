-------------------------------------------------
-- TARGET SYSTEM
-------------------------------------------------
local function FindTarget()
    local h = HRP()
    if not h then return nil end

    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end

    local best, bestValue = nil, math.huge

    for _, mob in ipairs(folder:GetChildren()) do
        local hum  = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            local dist = (root.Position - h.Position).Magnitude
            if dist > Config.AttackRange then continue end

            if Config.TargetMode == "Nearest" then
                if dist < bestValue then
                    bestValue = dist
                    best = mob
                end
            elseif Config.TargetMode == "LowestHealth" then
                if hum.Health < bestValue then
                    bestValue = hum.Health
                    best = mob
                end
            else -- Quest
                if dist < bestValue then
                    bestValue = dist
                    best = mob
                end
            end
        end
    end
    return best
end

