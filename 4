-------------------------------------------------
-- MULTI HIT (ตามโค้ดที่คุณให้มา)
-------------------------------------------------
local RegisterAttack, RegisterHit
pcall(function()
    local Net = RS:WaitForChild("Modules", 5):WaitForChild("Net", 5)
    RegisterAttack = Net:WaitForChild("RE/RegisterAttack", 5)
    RegisterHit    = Net:WaitForChild("RE/RegisterHit", 5)
end)

local function GetTargets(maxRange)
    local list = {}
    local h = HRP()
    if not h then return list end
    local pos = h.Position
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return list end

    for _, mob in ipairs(folder:GetChildren()) do
        local hum  = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            if (root.Position - pos).Magnitude <= maxRange then
                local part = mob:FindFirstChild("LeftUpperArm")
                    or mob:FindFirstChild("UpperTorso")
                    or root
                table.insert(list, { mob = mob, part = part })
            end
        end
    end
    return list
end

local function DoMultiHit()
    if not Config.FastAttack and not Config.AutoAttack then return end
    if not RegisterAttack or not RegisterHit then return end

    local targets = GetTargets(Config.AttackRange)
    if #targets == 0 then return end

    pcall(function()
        RegisterAttack:FireServer(0.5)
    end)
    for _, t in ipairs(targets) do
        pcall(function()
            RegisterHit:FireServer(t.part, {})
        end)
    end
end

-------------------------------------------------
-- ITEM / EQUIP MANAGER
-------------------------------------------------
local function GetSelectedItem()
    return Config.SelectedItem
end

local function IsSelectedItemAvailable()
    local name = Config.SelectedItem
    if name == "" then return false end

    local bag = LP:FindFirstChild("Backpack")
    local char = Char()
    if bag and bag:FindFirstChild(name) then return true end
    if char and char:FindFirstChild(name) then return true end
    return false
end

local function EquipSelectedItem()
    if not Config.ItemLock then return end
    local name = Config.SelectedItem
    if name == "" then return end

    -- ถ้าถืออยู่แล้วไม่ต้องทำอะไร
    local char = Char()
    if char then
        local held = char:FindFirstChildOfClass("Tool")
        if held and held.Name == name then
            Config.CurrentEquipped = name
            return
        end
    end

    if not IsSelectedItemAvailable() then
        Notify("Selected Item Not Found")
        return
    end

    pcall(function()
        local hum = Hum()
        local bag = LP:FindFirstChild("Backpack")
        if not hum or not bag then return end

        local held = char and char:FindFirstChildOfClass("Tool")
        if held then held.Parent = bag end

        local tool = bag:FindFirstChild(name)
        if tool then
            hum:EquipTool(tool)
            Config.CurrentEquipped = name
        end
    end)
end

local function ScanInventory()
    local list = {}
    local function add(folder)
        if not folder then return end
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(list, item.Name)
            end
        end
    end
    add(LP:FindFirstChild("Backpack"))
    add(Char())
    return list
end

