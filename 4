        Notify("Target Mode: Nearest")
    end)
    CreateButton("Target: Lowest Health", function()
        Config.TargetMode = "LowestHealth"
        Notify("Target Mode: Lowest Health")
    end)
end

local function BuildInventoryTab()
    ClearContent()
    CreateLabel("Selected: " .. (Config.SelectedItem \~= "" and Config.SelectedItem or "None"))
    CreateLabel("Equipped: " .. (Config.CurrentEquipped \~= "" and Config.CurrentEquipped or "None"))
    CreateToggle("Item Lock", "ItemLock")

    CreateButton("Refresh Inventory", function()
        local items = ScanInventory()
        Notify("Found " .. #items .. " items")
        BuildInventoryTab() -- refresh UI
    end)

    local items = ScanInventory()
    for _, name in ipairs(items) do
        local isSelected = (name == Config.SelectedItem)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 34)
        btn.BackgroundColor3 = isSelected and Color3.fromRGB(40, 90, 50) or Color3.fromRGB(28, 32, 42)
        btn.BorderSizePixel = 0
        btn.Text = (isSelected and "  ✓  " or "  ○  ") .. name
        btn.TextColor3 = Color3.fromRGB(235, 240, 250)
        btn.TextSize = 13
        btn.Font = Enum.Font.Gotham
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = Content
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        btn.MouseButton1Click:Connect(function()
            Config.SelectedItem = name
            Notify("Selected: " .. name)
            EquipSelectedItem()
            BuildInventoryTab()
        end)
    end
end

local function BuildSettingsTab()
