local function SwitchTab(name)
    CurrentTab = name
    for n, b in pairs(TabButtons) do
        b.BackgroundColor3 = (n == name) and Config.AccentColor or Color3.fromRGB(30, 34, 45)
    end
    if name == "Farm" then BuildFarmTab()
    elseif name == "Combat" then BuildCombatTab()
    elseif name == "Inventory" then BuildInventoryTab()
    elseif name == "Settings" then BuildSettingsTab()
    end
end

