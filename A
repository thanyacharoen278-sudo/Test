-- AUTO FARM LOOP (เสถียร)
-------------------------------------------------
local function StartAutoFarm()
    if FarmRunning then return end
    FarmRunning = true
    AttackAlways = true
    SetNoclip(true)
    task.spawn(function()
        local questTries = 0
        while FarmRunning do
            pcall(function()
                CheckLevel()
                AutoHaki()
                if not GetEquippedTool() then
                    EquipMelee()
                end

                local h = HRP()
                if not h then return end

                -- รับเควส (ลองไม่เกิน 3 ครั้ง แล้วไปฟาร์มต่อ)
                if not HasQuest() and questTries < 3 then
                    local d = (h.Position - CFrameQ.Position).Magnitude
                    if d > 18 then
                        TweenTo(CFrameQ * CFrame.new(0, 6, 0))
                        task.wait(0.4)
                    else
                        CancelTween()
                        h.CFrame = CFrameQ * CFrame.new(0, 6, 0)
                        TakeQuest()
                        questTries = questTries + 1
                        task.wait(1.2)
                    end
                    -- ถ้ายังไม่มีเควสและลองครบแล้ว → ไปฟาร์มเลย
                    if not HasQuest() and questTries >= 3 then
                        -- ไปจุดมอน
                    elseif not HasQuest() then
                        return
                    end
                end

                if HasQuest() then
                    questTries = 0
                end

                -- หามอน: ชื่อเควส → ชื่อ Ms → มอนใกล้จุด CFrameMon → มอนใกล้ตัว
                local mob = FindMob(NameMon) or FindMob(Ms)
                if not mob then
                    -- มอนใกล้จุดเกิดมอน
                    local folder = workspace:FindFirstChild("Enemies")
                    local best, bestD = nil, 350
                    if folder then
                        for _, m in ipairs(folder:GetChildren()) do
                            local hum = m:FindFirstChildOfClass("Humanoid")
                            local root = m:FindFirstChild("HumanoidRootPart")
                            if hum and root and hum.Health > 0 then
                                local d = (root.Position - CFrameMon.Position).Magnitude
                                if d < bestD then
                                    bestD = d
                                    best = m
                                end
                            end
                        end
                    end
                    mob = best or FindNearestMob(250)
                end

                if mob then
                    local root = mob:FindFirstChild("HumanoidRootPart")
                    if root then
                        FloatAt(root.Position)
                        AttackNoCoolDown()
                    end
                else
                    -- ไปจุดมอน รอสปอว์น
                    local d = (h.Position - CFrameMon.Position).Magnitude
                    if d > 30 then
                        TweenTo(CFrameMon * CFrame.new(0, 18, 0))
                    else
                        FloatAt(CFrameMon.Position)
                    end
                end
            end)
            task.wait(0.22)
        end
        CancelTween()
        ClearBody()
        SetNoclip(false)
