local RegisterAttack, RegisterHit
task.spawn(function()
    pcall(function()
        local Net = RS:WaitForChild("Modules", 10):WaitForChild("Net", 10)
        RegisterAttack = Net:WaitForChild("RE/RegisterAttack", 8)
        RegisterHit = Net:WaitForChild("RE/RegisterHit", 8)
    end)
end)

local AttackRange = 120

local function GetEquippedTool()
    local c = LP.Character
    if not c then return nil end
    return c:FindFirstChildOfClass("Tool")
end

local function FindEnemiesInRange(list, enemies)
    local h = HRP()
    if not h then return nil end
    local pos = h.Position
    local mainHead = nil
    for _, mob in ipairs(enemies) do
        if mob:IsA("Model") and not mob:GetAttribute("IsBoat") then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local head = mob:FindFirstChild("Head")
                    or mob:FindFirstChild("HumanoidRootPart")
                local root = mob:FindFirstChild("HumanoidRootPart")
                if head and root and (pos - root.Position).Magnitude <= AttackRange then
                    table.insert(list, { mob, head })
                    mainHead = head
                end
            end
        end
    end
    return mainHead
end

function AttackNoCoolDown()
    local tool = GetEquippedTool()
    if not tool then
        EquipMelee()
        tool = GetEquippedTool()
        if not tool then return end
    end

    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return end

    local list = {}
    local mainHead = FindEnemiesInRange(list, folder:GetChildren())
    if not mainHead or #list == 0 then return end

    if not RegisterAttack or not RegisterHit then
        pcall(function()
            local Net = RS.Modules.Net
            RegisterAttack = Net["RE/RegisterAttack"]
            RegisterHit = Net["RE/RegisterHit"]
        end)
    end
    if not RegisterAttack or not RegisterHit then return end

    pcall(function()
        RegisterAttack:FireServer(1e-9)
        RegisterHit:FireServer(mainHead, list)
    end)
end

