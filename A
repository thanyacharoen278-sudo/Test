-------------------------------------------------
-- HELPERS + MOVEMENT (Tween + Noclip + ลอยนิ่ง)
-------------------------------------------------
local ClipConn = nil
local BV = nil
local BG = nil

local function HRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Hum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function SetNoclip(on)
    if ClipConn then
        ClipConn:Disconnect()
        ClipConn = nil
    end
    if on then
        ClipConn = RunService.Stepped:Connect(function()
            local c = LP.Character
            if not c then return end
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                end
            end
        end)
    end
end

local function ClearBody()
    if BV then pcall(function() BV:Destroy() end) BV = nil end
    if BG then pcall(function() BG:Destroy() end) BG = nil end
end

local function EnsureBody()
    local h = HRP()
    if not h then return end
    ClearBody()
    BV = Instance.new("BodyVelocity")
    BV.Name = "DEKU_BV"
    BV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    BV.Velocity = Vector3.zero
    BV.Parent = h
    BG = Instance.new("BodyGyro")
    BG.Name = "DEKU_BG"
    BG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    BG.P = 3000
    BG.Parent = h
end

local function CancelTween()
    if farmTween then
        pcall(function() farmTween:Cancel() end)
        farmTween = nil
    end
end

-- Tween ทะลุกำแพง (noclip ระหว่างทาง)
local function TweenTo(cf)
    local h = HRP()
    if not h then return end
    SetNoclip(true)
    EnsureBody()
    CancelTween()
    local dist = (h.Position - cf.Position).Magnitude
    local spd = math.max(tonumber(TweenSpeed) or 200, 50)
    local t = math.clamp(dist / spd, 0.05, 6)
    if dist < 6 then
        h.CFrame = cf
        if BV then BV.Velocity = Vector3.zero end
        return
    end
    farmTween = TweenService:Create(h, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = cf })
    farmTween:Play()
    if BV then BV.Velocity = Vector3.zero end
end

-- ลอยนิ่งเหนือตำแหน่ง (ไม่เด้ง)
local function FloatAt(pos)
    local h = HRP()
    if not h then return end
    SetNoclip(true)
    EnsureBody()
    local target = CFrame.new(pos.X, pos.Y + 18, pos.Z)
    local dist = (h.Position - target.Position).Magnitude
    if dist > 20 then
        TweenTo(target)
    else
        CancelTween()
        h.CFrame = target
        if BV then BV.Velocity = Vector3.zero end
        if BG then BG.CFrame = target end
        h.AssemblyLinearVelocity = Vector3.zero
    end
end

local lastQuestTick = 0

local function HasQuest()
    local ok, vis = pcall(function()
        local main = LP.PlayerGui:FindFirstChild("Main")
        local q = main and main:FindFirstChild("Quest")
        return q and q.Visible
    end)
    return ok and vis
end

local function TakeQuest()
    if tick() - lastQuestTick < 4 then return end
    lastQuestTick = tick()
    pcall(function()
        RS.Remotes.CommF_:InvokeServer("StartQuest", NameQuest, QuestLv)
    end)
end

local function FindMob(name)
    local folder = workspace:FindFirstChild("Enemies")
    if not folder or not name or name == "" then return nil end
    local h = HRP()
    local key = string.lower(tostring(name))
    -- ตัดคำต่อท้ายเช่น "lv" ออกจากคีย์
    key = key:gsub("%s*%[.-%]", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    local best, bestD = nil, math.huge
    for _, mob in ipairs(folder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            local mn = string.lower(mob.Name)
            mn = mn:gsub("%s*%[.-%]", "")
            if string.find(mn, key, 1, true) or string.find(key, mn, 1, true) then
                local d = h and (root.Position - h.Position).Magnitude or 0
                if d < bestD then
                    bestD = d
                    best = mob
                end
            end
        end
    end
    return best
end

local function FindNearestMob(maxDist)
    maxDist = maxDist or 500
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    local h = HRP()
    if not h then return nil end
    local best, bestD = nil, maxDist
    for _, mob in ipairs(folder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            local d = (root.Position - h.Position).Magnitude
            if d < bestD then
                bestD = d
                best = mob
            end
        end
    end
    return best
end

local lastEquipTick = 0
local function EquipMelee()
    local c = LP.Character
    if not c then return end
    -- ถืออาวุธอยู่แล้ว ไม่ต้องสลับ
    if c:FindFirstChildOfClass("Tool") then return end
    -- กันเรียกถี่เกินไป
    if tick() - lastEquipTick < 1.5 then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local pick = nil
    for _, t in ipairs(LP.Backpack:GetChildren()) do
        if t:IsA("Tool") and (t.ToolTip == "Melee" or string.find(string.lower(t.Name), "combat")) then
            pick = t
            break
        end
    end
    if not pick then
        for _, t in ipairs(LP.Backpack:GetChildren()) do
            if t:IsA("Tool") then
                pick = t
                break
            end
        end
    end
    if pick then
        lastEquipTick = tick()
        pcall(function() hum:EquipTool(pick) end)
    end
end

local function AutoHaki()
    pcall(function()
        local c = LP.Character
        if c and not c:FindFirstChild("HasBuso") then
            RS.Remotes.CommF_:InvokeServer("Buso")
        end
    end)
end

