local function NoShake()
    pcall(function()
        local util = RS:FindFirstChild("Util")
        local s = util and util:FindFirstChild("CameraShaker")
        if s then
            local m = require(s)
            if m and m.Stop then m:Stop() end
        end
    end)
end

local function FloatTo(mob, dt)
    local h = HRP()
    if not h or not mob then return end
    local root = mob:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local goal = root.Position + Vector3.new(0, FLOAT_HEIGHT, 0)
    local cur = h.Position
    local dist = (goal - cur).Magnitude
    local newPos
    if dist > 80 then
        newPos = cur + (goal - cur).Unit * 70
    elseif dist > 1.5 then
        local a = math.clamp((dt or 0.016) * 14, 0.15, 0.45)
        newPos = cur:Lerp(goal, a)
    else
        newPos = goal
    end
    h.CFrame = CFrame.lookAt(newPos, root.Position + Vector3.new(0, 0.5, 0))
    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
    local hum = Hum()
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
    end
end

local function DoM1()
    NoShake()

    -- Equip Weapon
    if State.SelectWeapon then
        EquipTool(State.SelectWeapon)
    end

    -- CombatFramework Fast Attack
    pcall(function()
        if not AC then
            LoadCombat()
        end

        local c = AC and AC.activeController
        if c then
            c.timeToNextAttack = 0
            c.attacking = false
            c.blocking = false

            -- Fast Attack
            c.hitboxMagnitude = 120

            if type(c.increment) == "number" then
                c.increment = 3
            end

            if type(c.attack) == "function" then
                c:attack()
            end
        end
    end)

    -- Tool Activate
    pcall(function()
        local char = Char()
        local tool = char and char:FindFirstChildOfClass("Tool")

        if tool then
            tool:Activate()
        end
    end)

    -- VirtualInputManager M1
    pcall(function()
        if not VIM then return end

        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(800, 600)

        local x = vp.X / 2
        local y = vp.Y / 2

        VIM:SendMouseButtonEvent(
            x, y, 0, true, game, 1
        )

        task.wait(0.02)

        VIM:SendMouseButtonEvent(
            x, y, 0, false, game, 1
        )
    end)

    -- VirtualUser
    pcall(function()
        if _G.FastAttack then
            local VU = game:GetService("VirtualUser")

            VU:CaptureController()
            VU:Button1Down(
                Vector2.new(1280, 672)
            )
        end
    end)
end
