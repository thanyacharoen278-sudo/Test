local function Char()
    return LP.Character
end
local function Hum()
    local c = Char()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function HRP()
    local c = Char()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetLevel()
    local ok, v = pcall(function()
        return LP.Data.Level.Value
    end)
    return ok and v or 0
end

local function CommF_(...)
    local args = { ... }
    return pcall(function()
        return RS:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer(unpack(args))
    end)
end

local function EquipTool(name)
    if not name or name == "None" then return end
    pcall(function()
        local hum, char = Hum(), Char()
        if not hum or not char then return end
        if char:FindFirstChild(name) then return end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        local t = bag:FindFirstChild(name)
        if t and t:IsA("Tool") then hum:EquipTool(t) end
    end)
end

local function CheckQuest()
    local level = GetLevel()
    Current = nil
    for _, q in ipairs(QuestData) do
        if level >= q.minLevel then
            Current = q
            return
        end
    end
end

local function HasQuest()
    local ok, vis = pcall(function()
        return LP.PlayerGui.Main.Quest.Visible
    end)
    return ok and vis == true
end

local function TakeQuest()
    if not Current then return end
    CommF_("StartQuest", Current.quest, Current.questId or 1)
end

local function FindMob(name)
    if not name then return nil end
    local h = HRP()
    if not h then return nil end
    local best, bestD = nil, 1e9

    local function consider(m)
        if not m or not m:IsA("Model") then return end
        if m.Name == name then
        else
            return
        end
        local hum = m:FindFirstChildOfClass("Humanoid")
        local root = m:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum.Health <= 0 then return end
        local d = (h.Position - root.Position).Magnitude
        if d < bestD then best, bestD = m, d end
    end

    pcall(function()
        local folder = workspace:FindFirstChild("Enemies")
        if folder then
            for _, m in ipairs(folder:GetChildren()) do consider(m) end
        end
        for _, m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") then consider(m) end
        end
    end)
    return best
end

local function LoadCombat()
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        local cf = ps and ps:FindFirstChild("CombatFramework")
        if cf then AC = require(cf) end
    end)
    pcall(function()
        if AC and AC.activeController then return end
        if type(getreg) == "function" then
            for _, v in pairs(getreg()) do
                if type(v) == "table" and rawget(v, "activeController") then
                    AC = v
                    break
                end
            end
        end
    end)
end
