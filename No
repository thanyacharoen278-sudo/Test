    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(50, 140, 255)
    stroke.Thickness = 1.5
    stroke.Parent = btn

    local uiVisible = true
    local dragging, dragStart, startPos

    local function toggleUI()
        uiVisible = not uiVisible
        pcall(function()
            if Window.Minimize then
                -- Fluent minimize if available
                if not uiVisible then
                    Window:Minimize()
                end
            end
        end)
        -- ซ่อน/โชว์ container ของ Fluent
        pcall(function()
            for _, g in ipairs(LP.PlayerGui:GetChildren()) do
                if g:IsA("ScreenGui") and (g.Name:find("Fluent") or g.Name:find("DEKUx") or g.Name:find("Window")) then
                    if g.Name ~= "DEKUxHUB_Logo" then
                        g.Enabled = uiVisible
                    end
                end
            end
            if typeof(gethui) == "function" then
                for _, g in ipairs(gethui():GetChildren()) do
                    if g:IsA("ScreenGui") and g.Name ~= "DEKUxHUB_Logo" then
                        if g.Name:find("Fluent") or g:FindFirstChild("Main") then
                            g.Enabled = uiVisible
                        end
                    end
                end
            end
        end)
        btn.TextTransparency = uiVisible and 0 or 0.35
        stroke.Color = uiVisible and Color3.fromRGB(50, 140, 255) or Color3.fromRGB(80, 80, 80)
    end

    btn.MouseButton1Click:Connect(function()
        if dragging then return end
        toggleUI()
    end)

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    task.delay(0.05, function() dragging = false end)
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end)


