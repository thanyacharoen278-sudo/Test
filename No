local function StartAutoFarm()
    if FarmRunning then return end
    FarmRunning = true
    AttackAlways = true
    task.spawn(function()
        local goingQuest = false
        while FarmRunning do
            pcall(function()
                CheckLevel()
                AutoHaki()
                EquipMelee()

                local h = HRP()
                if not h then return end

                -- 1) รับเควสเฉพาะเมื่อยังไม่มี
                if not HasQuest() then
                    local qpos = CFrameQ.Position
                    local d = (h.Position - qpos).Magnitude
                    if d > 15 then
                        goingQuest = true
                        TweenTo(CFrameQ * CFrame.new(0, 5, 0))
                    else
                        CancelTween()
                        h.CFrame = CFrameQ * CFrame.new(0, 5, 0)
                        TakeQuest()
                        task.wait(0.8)
                        goingQuest = false
                    end
                    if goingQuest then return end
                else
                    goingQuest = false
                end

                -- 2) มีเควสแล้ว → ไปฟาร์มมอน (ไม่กลับเควส)
                local mob = FindMob(NameMon) or FindMob(Ms)
                if mob then
                    local root = mob:FindFirstChild("HumanoidRootPart")
                    if root then
                        -- ลอยนิ่งเหนือมอน (ไม่ใช้ orbit ตอนฟาร์ม กันเด้ง)
                        FloatAt(root.Position)
                        AttackNoCoolDown()
                    end
                else
                    -- ยังไม่เจอมอน → ไปจุดเกิดมอน
                    FloatAt(CFrameMon.Position)
                end
            end)
            task.wait(0.2)
        end
        CancelTween()
    end)
end

local function StopAutoFarm()
    FarmRunning = false
    if not AutoNextIsland and not Auto_Law then
        AttackAlways = false
    end
    CancelTween()
end

