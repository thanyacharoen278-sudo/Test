local function GetEquippedTool()
    local c = LP.Character
    if not c then return nil end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            return t
        end
    end
    return nil
end

local function FindEnemiesInRange(list, enemies)
    local char = LP.Character
    if not char then return nil end
    local ok, pos = pcall(function()
        return char:GetPivot().Position
    end)
    if not ok or not pos then return nil end

    local mainHead = nil
    for _, mob in ipairs(enemies) do
        if not mob:GetAttribute("IsBoat") then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local head = mob:FindFirstChild("Head")
                if head and (pos - head.Position).Magnitude <= AttackRange then
                    if mob ~= char then
                        table.insert(list, { mob, head })
                        mainHead = head
                    end
                end
            end
        end
    end
    return mainHead
end

function AttackNoCoolDown()
    local list = {}
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return end

    -- ถืออาวุธก่อน ไม่งั้นไม่ตี
    if not GetEquippedTool() then
        EquipMelee()
    end
    local tool = GetEquippedTool()
    if not tool then return end

    local mainHead = FindEnemiesInRange(list, folder:GetChildren())
    if not mainHead or #list == 0 then return end

    if not RegisterAttack or not RegisterHit then
        pcall(function()
            local Net = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("Net")
            if Net then
                RegisterAttack = Net:FindFirstChild("RE/RegisterAttack")
                RegisterHit = Net:FindFirstChild("RE/RegisterHit")
            end
        end)
    end
    if not RegisterAttack or not RegisterHit then return end

    pcall(function()
        RegisterAttack:FireServer(1e-9)
        RegisterHit:FireServer(mainHead, list)
    end)
end

