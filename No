local function HRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local lastQuestName = ""
local questCooldown = 0

local function HasQuest()
    local ok, visible = pcall(function()
        local q = LP.PlayerGui:FindFirstChild("Main")
        q = q and q:FindFirstChild("Quest")
        return q and q.Visible
    end)
    return ok and visible
end

local function TakeQuest()
    if tick() - questCooldown < 3 then return end
    questCooldown = tick()
    pcall(function()
        RS.Remotes.CommF_:InvokeServer("StartQuest", NameQuest, QuestLv)
    end)
    lastQuestName = NameQuest
end

local function CancelTween()
    if farmTween then
        pcall(function() farmTween:Cancel() end)
        farmTween = nil
    end
end

local function TweenTo(cf)
    local h = HRP()
    if not h then return end
    local dist = (h.Position - cf.Position).Magnitude
    if dist < 8 then
        h.CFrame = cf
        h.AssemblyLinearVelocity = Vector3.zero
        return
    end
    CancelTween()
    local spd = tonumber(TweenSpeed) or 175
    local t = math.clamp(dist / spd, 0.08, 8)
    farmTween = TweenService:Create(h, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = cf })
    farmTween:Play()
end

-- ลอยนิ่งเหนือมอน ไม่เด้งไปมา
local function FloatAt(pos)
    local h = HRP()
    if not h then return end
    local targetPos = Vector3.new(pos.X, pos.Y + 18, pos.Z)
    local dist = (h.Position - targetPos).Magnitude
    if dist > 25 then
        TweenTo(CFrame.new(targetPos))
    else
        CancelTween()
        h.CFrame = CFrame.new(targetPos)
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end
end

local function FindMob(name)
    local folder = workspace:FindFirstChild("Enemies")
    if not folder or not name or name == "" then return nil end
    local h = HRP()
    local best, bestD = nil, math.huge
    for _, mob in ipairs(folder:GetChildren()) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            if string.find(string.lower(mob.Name), string.lower(name), 1, true) then
                local d = h and (root.Position - h.Position).Magnitude or 0
                if d < bestD then
                    bestD = d
                    best = mob
                end
            end
        end
    end
    return best
end

local function EquipMelee()
    local c = LP.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    for _, t in ipairs(LP.Backpack:GetChildren()) do
        if t:IsA("Tool") and (t.ToolTip == "Melee" or string.find(string.lower(t.Name), "combat")) then
            pcall(function() hum:EquipTool(t) end)
            return
        end
    end
    for _, t in ipairs(LP.Backpack:GetChildren()) do
        if t:IsA("Tool") then
            pcall(function() hum:EquipTool(t) end)
            return
        end
    end
end

