RunService.Heartbeat:Connect(function(dt)
    if State.AntiShake then KillShake() end
    local needTarget = State.Lock or State.FlyTo or State.Aimbot or State.AutoAttack
    if not needTarget then return end
    if not GetTargetHRP() then return end
    if State.Lock or State.FlyTo then
        LockOnTarget(dt)
    end
    if State.Aimbot then
        AimAtTarget()
    end
end)

RunService.RenderStepped:Connect(function()
    if not State.AutoAttack then return end
    if not GetTargetHRP() then return end
    pcall(function()
        if not AC then LoadCombat() end
        local c = AC and AC.activeController
        if c then
            c.timeToNextAttack = 0
            c.hitboxMagnitude = HITBOX
            c.attacking = false
        end
    end)
    if State.AntiShake then KillShake() end
end)

