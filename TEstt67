local function PlayerList()
    local list = { "None" }
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then
        else
            table.insert(list, plr.Name)
        end
    end
    table.sort(list)
    -- จัด None ให้อยู่บนสุด
    local out = { "None" }
    for _, n in ipairs(list) do
        if n == "None" then
        else
            table.insert(out, n)
        end
    end
    return out
end

