-- STATE
-------------------------------------------------
local State = {
    Lock = false,
    FlyTo = false,
    AutoAttack = false,
    Aimbot = false,
    AntiShake = true,
    TargetName = "None",
}

local LOCK_HEIGHT = 4
local FLY_SPEED = 180
local HITBOX = 55
local AC = nil

local function Char()
    return LP.Character
end
local function Hum()
    local c = Char()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function HRP()
    local c = Char()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetTargetPlayer()
    if State.TargetName == "None" or State.TargetName == "" then
        return nil
    end
    return Players:FindFirstChild(State.TargetName)
end

local function GetTargetHRP()
    local plr = GetTargetPlayer()
    if not plr then return nil end
    local c = plr.Character
    if not c then return nil end
    local hu = c:FindFirstChildOfClass("Humanoid")
    if hu and hu.Health <= 0 then return nil end
    return c:FindFirstChild("HumanoidRootPart")
end

