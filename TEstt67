-- LOCK / FLY / AIM
-------------------------------------------------
local function SmoothMoveTo(goal, dt, speed)
    local h = HRP()
    if not h then return end
    local cur = h.Position
    local dist = (goal - cur).Magnitude
    if dist < 1.5 then
        h.CFrame = CFrame.new(goal) * (h.CFrame - h.CFrame.Position)
        pcall(function()
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end)
        return
    end
    local step = math.min(dist, (speed or FLY_SPEED) * (dt or 0.016))
    local dir = (goal - cur).Unit
    local np = cur + dir * step
    h.CFrame = CFrame.new(np, goal)
    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function LockOnTarget(dt)
    local th = GetTargetHRP()
    local h = HRP()
    if not th or not h then return end
    local goal = th.Position + Vector3.new(0, LOCK_HEIGHT, 0)
    SmoothMoveTo(goal, dt, FLY_SPEED)
    local hum = Hum()
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
    end
end

local function AimAtTarget()
    local th = GetTargetHRP()
    local h = HRP()
    if not th or not h then return end
    local look = th.Position + Vector3.new(0, 1.6, 0)
    local pos = h.Position
    h.CFrame = CFrame.lookAt(pos, look)
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then
            cam.CFrame = CFrame.lookAt(cam.CFrame.Position, look)
        end
    end)
end

