-- COMBAT
-------------------------------------------------
local function EquipWeapon()
    pcall(function()
        local char, hum = Char(), Hum()
        if not char or not hum then return end
        if char:FindFirstChildOfClass("Tool") then return end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                local n = string.lower(t.Name)
                if not string.find(n, "fruit", 1, true) and not string.find(n, "gum", 1, true) then
                    hum:EquipTool(t)
                    return
                end
            end
        end
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                hum:EquipTool(t)
                return
            end
        end
    end)
end

local function LoadCombat()
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        if not ps then return end
        local cf = ps:FindFirstChild("CombatFramework")
        if cf then AC = require(cf) end
    end)
    pcall(function()
        if AC and AC.activeController then return end
        if type(getreg) == "function" then
            for _, v in pairs(getreg()) do
                if type(v) == "table" and rawget(v, "activeController") then
                    AC = v
                    break
                end
            end
        end
    end)
end

LoadCombat()
LP.CharacterAdded:Connect(function()
    task.wait(1)
    AC = nil
    LoadCombat()
end)

local function KillShake()
    if not State.AntiShake then return end
    pcall(function()
        local util = RS:FindFirstChild("Util")
        if util and util:FindFirstChild("CameraShaker") then
            local m = require(util.CameraShaker)
            if m and m.Stop then m:Stop() end
        end
    end)
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        if not ps then return end
        local cf = ps:FindFirstChild("CombatFramework")
        if not cf then return end
        local cam = cf:FindFirstChild("CameraShaker")
        if cam then
            local m = require(cam)
            if m and m.CameraShakeInstance then
                m.CameraShakeInstance.CameraShakeState = {
                    FadingIn = 3, FadingOut = 2, Sustained = 0, Inactive = 1
                }
            end
        end
    end)
end

local function DoAttack()
    KillShake()
    EquipWeapon()
    pcall(function()
        if not AC then LoadCombat() end
        local c = AC and AC.activeController
        if c then
            c.timeToNextAttack = 0
            c.attacking = false
            c.blocking = false
            c.hitboxMagnitude = HITBOX
            if type(c.increment) == "number" then c.increment = 1 end
            if type(c.attack) == "function" then c:attack() end
        end
    end)
    pcall(function()
        local tool = Char() and Char():FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end)
end

