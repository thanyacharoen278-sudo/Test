local function M1()
    if m1Busy then return end
    m1Busy = true

    task.spawn(function()
        pcall(function()
            NoShake()
            Equip()

            -- 1) CombatFramework
            if not AC then LoadCF() end
            local c = AC and AC.activeController
            if c then
                c.timeToNextAttack = 0
                c.attacking = false
                c.blocking = false
                c.hitboxMagnitude = HITBOX
                if type(c.increment) == "number" then c.increment = 1 end
                if type(c.attack) == "function" then
                    c:attack()
                end
            end

            -- 2) Tool Activate
            local tool = Char() and Char():FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end

            -- 3) VirtualInputManager = M1 จริงของเกม
            if VIM then
                local cam = workspace.CurrentCamera
                local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
                local x, y = vp.X / 2, vp.Y / 2
                VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)
                task.wait(0.03)
                VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
            end

            -- 4) สำรอง VirtualUser (บาง executor)
            pcall(function()
                VU:CaptureController()
                VU:Button1Down(Vector2.new(0, 0))
                task.wait(0.03)
                VU:Button1Up(Vector2.new(0, 0))
            end)
        end)
        m1Busy = false
    end)
end

