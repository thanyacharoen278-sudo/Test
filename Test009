local function GoTo(goal, dt)
    local h = HRP()
    if not h then return end
    local cur = h.Position
    local dist = (goal - cur).Magnitude
    if dist < 1.2 then
        h.CFrame = CFrame.new(goal)
    elseif dist > 250 then
        h.CFrame = CFrame.new(cur + (goal - cur).Unit * 220, goal)
    else
        local alpha = math.clamp((dt or 0.016) * (FLY_SPEED / 40), 0.15, 0.55)
        h.CFrame = CFrame.new(cur:Lerp(goal, alpha), goal)
    end
    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
    local hum = Hum()
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
    end
end

local function Aim()
    local th = TargetRoot()
    local h = HRP()
    if not th or not h then return end
    local look = th.Position + Vector3.new(0, 1.5, 0)
    h.CFrame = CFrame.lookAt(h.Position, look)
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, look) end
    end)
end

RunService.RenderStepped:Connect(function(dt)
    if ON.Shake then NoShake() end
    local need = ON.Lock or ON.Fly or ON.Aim or ON.Attack
    if not need then return end
    local th = TargetRoot()
    if not th then return end
    if ON.Lock or ON.Fly then
        GoTo(th.Position + Vector3.new(0, LOCK_Y, 0), dt)
    end
    if ON.Aim then Aim() end
    if ON.Attack then
        pcall(function()
            if not AC then LoadCF() end
            local c = AC and AC.activeController
            if c then
                c.timeToNextAttack = 0
                c.hitboxMagnitude = HITBOX
                c.attacking = false
            end
        end)
    end
end)

