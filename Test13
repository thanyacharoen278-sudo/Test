RunService.Heartbeat:Connect(function(dt)
    if State.Speed and not State.AutoFarm and not State.AutoRaid then
        pcall(function()
            local hum, h = Hum(), HRP()
            if not hum or not h then return end
            hum.WalkSpeed = State.WalkSpeed
            if not waterPart or not waterPart.Parent then
                local p = Instance.new("Part")
                p.Name = "D_Water"
                p.Size = Vector3.new(10, 1, 10)
                p.Transparency = 1
                p.Anchored = true
                p.CanCollide = true
                p.Parent = workspace
                waterPart = p
            end
            waterPart.CFrame = CFrame.new(h.Position.X, h.Position.Y - 3, h.Position.Z)
        end)
    else
        ClearWater()
    end

    if not (State.AutoFarm or State.AutoRaid) then return end

    pcall(function()
        local range = State.AutoRaid and RAID_RANGE or FARM_RANGE
        local enemy = GetEnemy(range)
        if enemy then
            FloatOnHead(enemy, dt)
            BringSameName(enemy)
            EnsureHoldWeapon()
            DoAttack()
        elseif State.AutoRaid then
            FloatToNext(dt)
        end
    end)
end)

RunService.Stepped:Connect(function()
    if not (State.AutoFarm or State.AutoRaid) then return end
    pcall(function()
        local c = Char()
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end)

