-- ENEMY / BRING / FLOAT
-------------------------------------------------
local function isPlayerChar(model)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then return true end
    end
    return false
end

local function iterEnemies(fn)
    local en = workspace:FindFirstChild("Enemies")
    if en then
        for _, m in ipairs(en:GetChildren()) do
            if m:IsA("Model") then fn(m) end
        end
    end
    for _, m in ipairs(workspace:GetChildren()) do
        if m:IsA("Model") then fn(m) end
    end
end) 

local function GetEnemy(range)
    local h = HRP()
    if not h then return nil end
    local best, bd = nil, range or FARM_RANGE
    iterEnemies(function(m)
        if isPlayerChar(m) then return end
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hu = m:FindFirstChildOfClass("Humanoid")
        if mh and hu and hu.Health > 0 then
            local d = (h.Position - mh.Position).Magnitude
            if d < bd then best, bd = m, d end
        end
    end)
    return best
end) 

local function BringSameName(target)
    if not State.BringMobs or not target then return end
    local h = HRP()
    if not h then return end
    local name = target.Name
    local base = h.CFrame
    iterEnemies(function(m)
        if m == target then return end
        if m.Name == name then
        else
            return
        end
        if isPlayerChar(m) then return end
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hu = m:FindFirstChildOfClass("Humanoid")
        if not mh or not hu or hu.Health <= 0 then return end
        if (h.Position - mh.Position).Magnitude > BRING_RANGE then return end
        pcall(function()
            mh.CFrame = base * CFrame.new(
                math.random(-4, 4),
                -HEAD_HEIGHT + 1,
                math.random(-4, 4)
            )
            mh.AssemblyLinearVelocity = Vector3.zero
        end)
    end)
end) 

local function FloatOnHead(enemy, dt)
    local h = HRP()
    if not h or not enemy then return end
    local eh = enemy:FindFirstChild("HumanoidRootPart")
    if not eh then return end

    local goal = eh.Position + Vector3.new(0, HEAD_HEIGHT, 0)
    local cur = h.Position
    local dist = (goal - cur).Magnitude
    local a = math.clamp((dt or 0.016) * 18, 0.1, 0.4)
    local np = dist > 40 and goal or cur:Lerp(goal, a)
    h.CFrame = CFrame.lookAt(np, eh.Position + Vector3.new(0, 1.5, 0))

    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
    local hum = Hum()
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
    end
end

local function GetIslands()
    local list = {}
    local function add(obj)
        if not obj then return end
        local part = obj:IsA("BasePart") and obj
            or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)))
        if not part then return end
        local n = string.lower(obj.Name)
        if string.find(n, "island", 1, true)
            or string.find(n, "stage", 1, true)
            or string.find(n, "platform", 1, true) then
            table.insert(list, part)
        end
    end
    for _, o in ipairs(workspace:GetChildren()) do
        add(o)
        if o:IsA("Folder") or o:IsA("Model") then
            for _, ch in ipairs(o:GetChildren()) do add(ch) end
        end
    end
    return list
end

local function FloatToNext(dt)
    local h = HRP()
    if not h then return end
    local islands = GetIslands()
    if #islands == 0 then return end
    local best, score = nil, -1
    for _, p in ipairs(islands) do
        local d = (h.Position - p.Position).Magnitude
        local key = math.floor(p.Position.X / 60) .. "_" .. math.floor(p.Position.Z / 60)
        if d > 40 and d < 15000 and not visited[key] then
            local s = d < 5000 and d or 5000
            if s > score then score, best = s, p end
        end
    end
    if not best then
        visited = {}
        local far, fd = nil, 0
        for _, p in ipairs(islands) do
            local d = (h.Position - p.Position).Magnitude
            if d > fd and d > 50 then far, fd = p, d end
        end
        best = far
    end
    if not best then return end
    local key = math.floor(best.Position.X / 60) .. "_" .. math.floor(best.Position.Z / 60)
    local goal = best.Position + Vector3.new(0, 8, 0)
    local cur = h.Position
    local dist = (goal - cur).Magnitude
    if dist < 14 then
        visited[key] = true
        h.CFrame = CFrame.new(goal)
        return
    end
    local step = math.min(dist, 90 * (dt or 0.016))
    if dist > 0.05 then
        h.CFrame = CFrame.new(cur + (goal - cur).Unit * step)
    end
    pcall(function() h.AssemblyLinearVelocity = Vector3.zero end)
end

local function ClearWater()
    if waterPart then
        pcall(function() waterPart:Destroy() end)
        waterPart = nil
    end
end) 

