-- STATE
-------------------------------------------------
local State = {
    AutoFarm = false,
    AutoRaid = false,
    FastAttack = false,
    BringMobs = true,
    Speed = false,
    WalkSpeed = 120,
}

local HEAD_HEIGHT = 5.5
local HITBOX = 60
local FARM_RANGE = 2500
local RAID_RANGE = 12000
local BRING_RANGE = 350
local AC = nil
local visited = {}
local waterPart = nil

local function Char()
    return LP.Character
end
local function Hum()
    local c = Char()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function HRP()
    local c = Char()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function combatOn()
    return State.AutoFarm or State.AutoRaid or State.FastAttack
end

local function EquipWeapon()
    pcall(function()
        local char = Char()
        local hum = Hum()
        if not char or not hum then return end
        if char:FindFirstChildOfClass("Tool") then return end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                local n = string.lower(t.Name)
                if not string.find(n, "fruit", 1, true) and not string.find(n, "gum", 1, true) then
                    hum:EquipTool(t)
                    return
                end
            end
        end
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                hum:EquipTool(t)
                return
            end
        end
    end)
end) 

local function EnsureHoldWeapon()
    pcall(function()
        local char = Char()
        if not char then return end
        if char:FindFirstChildOfClass("Tool") then return end
        EquipWeapon()
    end)
end

local function LoadCombat()
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        if not ps then return end
        local cf = ps:FindFirstChild("CombatFramework")
        if cf then
            AC = require(cf)
        end
    end)
    pcall(function()
        if AC and AC.activeController then return end
        if type(getreg) == "function" then
            for _, v in pairs(getreg()) do
                if type(v) == "table" and rawget(v, "activeController") then
                    AC = v
                    break
                end
            end
        end
    end)
end) 

