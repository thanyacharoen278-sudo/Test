local visited = {}

local function getIslands()
    local list = {}
    local function add(obj)
        local part = obj:IsA("BasePart") and obj
            or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)))
        if not part then return end
        local n = string.lower(obj.Name)
        if string.find(n, "island") or string.find(n, "stage")
            or string.find(n, "platform") or string.find(n, "tower") then
            table.insert(list, part)
        end
    end
    for _, o in pairs(workspace:GetChildren()) do
        add(o)
        if o:IsA("Folder") or o:IsA("Model") then
            for _, c in pairs(o:GetChildren()) do add(c) end
        end
    end
    if #list == 0 then
        for _, o in pairs(workspace:GetDescendants()) do
            if o:IsA("BasePart") and o.Size.X > 35 and o.Size.Z > 35 and o.Position.Y > 8 then
                local n = string.lower(o.Name)
                if not string.find(n, "water") and not string.find(n, "sea") then
                    table.insert(list, o)
                    if #list > 20 then break end
                end
            end
        end
    end
    return list
end

local function floatToNextIsland(dt)
    local h = HRP()
    if not h then return end
    local islands = getIslands()
    if #islands == 0 then return end

    local best, bestScore = nil, -1
    for _, p in pairs(islands) do
        local d = (h.Position - p.Position).Magnitude
        local key = math.floor(p.Position.X / 60) .. "_" .. math.floor(p.Position.Z / 60)
        if d > 50 and d < 6000 and not visited[key] then
            local score = (d < 2000) and d or (2000 - (d - 2000) * 0.15)
            if score > bestScore then
                bestScore, best = score, p
            end
        end
    end

    if not best then
        visited = {}
        local far, farD = nil, 0
        for _, p in pairs(islands) do
            local d = (h.Position - p.Position).Magnitude
            if d > farD and d > 60 then far, farD = p, d end
        end
        best = far
    end
    if not best then return end

    local key = math.floor(best.Position.X / 60) .. "_" .. math.floor(best.Position.Z / 60)
    local goal = best.Position + Vector3.new(0, 8, 0)
    local cur = h.Position
    local dist = (goal - cur).Magnitude

    if dist < 12 then
        visited[key] = true
        h.CFrame = CFrame.new(goal)
        h.Velocity = Vector3.zero
        return
    end

    local step = math.min(dist, 90 * (dt or 0.016))
    h.CFrame = CFrame.new(cur + (goal - cur).Unit * step)
    h.Velocity = Vector3.zero
    pcall(function() h.AssemblyLinearVelocity = Vector3.zero end)
end

