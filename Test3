local hooked = false
local function tryHookCombat()
    if hooked then return end
    if not getreg or not debug or not debug.getupvalues then
        warn("[DEKUz] getreg/debug not available")
        return
    end
    pcall(function()
        for _, v in pairs(getreg()) do
            if typeof(v) == "function" then
                local envOk, env = pcall(function() return getfenv(v) end)
                if envOk and env and env.script == LP.PlayerScripts:FindFirstChild("CombatFramework") then
                    local upsOk, ups = pcall(function() return debug.getupvalues(v) end)
                    if upsOk and ups then
                        for _, upvalue in pairs(ups) do
                            if typeof(upvalue) == "table" and upvalue.activeController then
                                RunService.RenderStepped:Connect(function()
                                    if getgenv().Config["FastAttack"] then
                                        pcall(function()
                                            local controller = upvalue.activeController
                                            if not controller then return end
                                            controller.timeToNextAttack = 0
                                            controller.attacking = false
                                            controller.increment = 0
                                            controller.blocking = false
                                            controller.hitboxMagnitude = HITBOX
                                            if controller.humanoid then
                                                controller.humanoid.AutoRotate = true
                                            end
                                            controller.focusStart = 0
                                            controller.currentAttackTrack = nil
                                        end)
                                    end
                                end)
                                RunService.RenderStepped:Connect(function()
                                    if getgenv().Config["clickAttack"] then
                                        pcall(function()
                                            local cam = workspace.CurrentCamera
                                            local x = cam and cam.ViewportSize.X / 2 or 0
                                            local y = cam and cam.ViewportSize.Y / 2 or 1
                                            VU:CaptureController()
                                            VU:Button1Down(Vector2.new(x, y))
                                        end)
                                    end
                                end)
                                hooked = true
                                print("[DEKUz] CombatFramework hooked | Hitbox", HITBOX)
                                return
                            end
                        end
                    end
                end
            end
        end
    end)
end

