local function Equip()
    pcall(function()
        local c = LP.Character
        if not c or c:FindFirstChildOfClass("Tool") then return end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        for _, t in pairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                local h = Hum()
                if h then h:EquipTool(t) end
                return
            end
        end
    end)
end

local function GetEnemy(range)
    local h = HRP()
    if not h then return nil end
    local near, best = nil, range or 5000
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    for _, m in pairs(folder:GetChildren()) do
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if mh and hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(m) then
            local d = (h.Position - mh.Position).Magnitude
            if d < best then
                near, best = m, d
            end
        end
    end
    return near
end

