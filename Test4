        local enemy = GetEnemy(_G.AutoRaid and 8000 or 5000)

        if not enemy then
            if _G.AutoRaid then
                floatToNextIsland(dt)
                local hum = Hum()
                if hum then
                    hum.WalkSpeed = 0
                    hum.AutoRotate = false
                end
            end
            return
        end

        local eh = enemy:FindFirstChild("HumanoidRootPart")
        if not eh then return end

        local target = eh.Position + Vector3.new(0, HEAD_HEIGHT, 0)
        local cur = h.Position
        local dist = (target - cur).Magnitude
        local alpha = math.clamp((dt or 0.016) * 14, 0.1, 0.4)

        local newPos
        if dist > 90 then
            newPos = target
        else
            newPos = Vector3.new(
                lerp(cur.X, target.X, alpha),
                lerp(cur.Y, target.Y, alpha),
                lerp(cur.Z, target.Z, alpha)
            )
        end

        h.CFrame = CFrame.lookAt(newPos, eh.Position + Vector3.new(0, 0.5, 0))
        h.AssemblyLinearVelocity = Vector3.zero

        local hum = Hum()
        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.AutoRotate = false
        end
    end)
end)

