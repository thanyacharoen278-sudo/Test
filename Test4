local controllerRef = nil

local function findController()
    local ok = pcall(function()
        if type(getreg) \~= "function" then return end
        if not debug or type(debug.getupvalues) \~= "function" then return end
        local ps = LP:FindFirstChild("PlayerScripts")
        if not ps then return end
        local cf = ps:FindFirstChild("CombatFramework")
        if not cf then return end
        for _, v in pairs(getreg()) do
            if typeof(v) == "function" then
                local envOk, env = pcall(getfenv, v)
                if envOk and type(env) == "table" and env.script == cf then
                    local upsOk, ups = pcall(debug.getupvalues, v)
                    if upsOk and type(ups) == "table" then
                        for _, up in pairs(ups) do
                            if type(up) == "table" and up.activeController then
                                controllerRef = up
                                return
                            end
                        end
                    end
                end
            end
        end
    end)
    return controllerRef \~= nil
end

