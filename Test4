local visited = {}

local function getIslands()
    local list = {}
    local function add(obj)
        if not obj then return end
        local part = nil
        if obj:IsA("BasePart") then
            part = obj
        elseif obj:IsA("Model") then
            part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
        end
        if not part then return end
        local n = string.lower(tostring(obj.Name))
        if string.find(n, "island", 1, true)
            or string.find(n, "stage", 1, true)
            or string.find(n, "platform", 1, true)
            or string.find(n, "tower", 1, true) then
            table.insert(list, part)
        end
    end
    for _, o in ipairs(workspace:GetChildren()) do
        add(o)
        if o:IsA("Folder") or o:IsA("Model") then
            for _, ch in ipairs(o:GetChildren()) do
                add(ch)
            end
        end
    end
    if #list == 0 then
        local count = 0
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("BasePart") and o.Size.X > 35 and o.Size.Z > 35 and o.Position.Y > 8 then
                local n = string.lower(tostring(o.Name))
                if not string.find(n, "water", 1, true) and not string.find(n, "sea", 1, true) then
                    table.insert(list, o)
                    count = count + 1
                    if count >= 20 then break end
                end
            end
        end
    end
    return list
end

local function floatToNextIsland(dt)
    local h = HRP()
    if not h then return end
    local islands = getIslands()
    if #islands == 0 then return end

    local best, bestScore = nil, -1
    for _, p in ipairs(islands) do
        local d = (h.Position - p.Position).Magnitude
        local key = math.floor(p.Position.X / 60) .. "_" .. math.floor(p.Position.Z / 60)
        if d > 50 and d < 6000 and not visited[key] then
            local score = (d < 2000) and d or (2000 - (d - 2000) * 0.15)
            if score > bestScore then
                bestScore = score
                best = p
            end
        end
    end

    if not best then
        visited = {}
        local far, farD = nil, 0
        for _, p in ipairs(islands) do
            local d = (h.Position - p.Position).Magnitude
            if d > farD and d > 60 then
                far = p
                farD = d
            end
        end
        best = far
    end
    if not best then return end

    local key = math.floor(best.Position.X / 60) .. "_" .. math.floor(best.Position.Z / 60)
    local goal = best.Position + Vector3.new(0, 8, 0)
    local cur = h.Position
    local dist = (goal - cur).Magnitude

    if dist < 12 then
        visited[key] = true
        h.CFrame = CFrame.new(goal)
        h.AssemblyLinearVelocity = Vector3.zero
        return
    end

    local step = math.min(dist, 90 * (dt or 0.016))
    local dir = (goal - cur)
    if dir.Magnitude > 0.01 then
        h.CFrame = CFrame.new(cur + dir.Unit * step)
    end
    h.AssemblyLinearVelocity = Vector3.zero
end

