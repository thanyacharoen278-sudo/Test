    row.AutoButtonColor = false
    row.Parent = Main
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -70, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = TEXT
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 15
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local badge = Instance.new("TextLabel")
    badge.Size = UDim2.new(0, 52, 0, 28)
    badge.Position = UDim2.new(1, -60, 0.5, -14)
    badge.BackgroundColor3 = OFF
    badge.Text = "OFF"
    badge.TextColor3 = TEXT
    badge.Font = Enum.Font.GothamBold
    badge.TextSize = 13
    badge.Parent = row
    Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 8)

    local on = false
    row.MouseButton1Click:Connect(function()
        on = not on
        State[key] = on
        badge.Text = on and "ON" or "OFF"
        badge.BackgroundColor3 = on and BLUE or OFF
        if key == "AutoRaid" and on then visited = {} end
        if key == "Speed" and not on then ClearWater() end
        if key == "ESP" then
            if on then RefreshESP() else ClearAllESP() end
        end
    end)

    y = y + 52
end

