RunService.RenderStepped:Connect(function()
    if not combatOn() then return end
    pcall(function()
        if not AC then LoadCombat() end
        local c = AC and AC.activeController
        if c then
            c.timeToNextAttack = 0
            c.hitboxMagnitude = HITBOX
            c.attacking = false
        end
    end)
    KillShake()
end)

RunService.Heartbeat:Connect(function(dt)
    if State.Speed and not State.AutoFarm and not State.AutoRaid then
        pcall(function()
            local hum, h = Hum(), HRP()
            if not hum or not h then return end
            hum.WalkSpeed = State.WalkSpeed
            if not waterPart or not waterPart.Parent then
                local p = Instance.new("Part")
                p.Name = "DEKUzWater"
                p.Size = Vector3.new(10, 1, 10)
                p.Transparency = 1
                p.Anchored = true
                p.CanCollide = true
                p.Parent = workspace
                waterPart = p
            end
            waterPart.CFrame = CFrame.new(h.Position.X, h.Position.Y - 3, h.Position.Z)
        end)
    else
        ClearWater()
    end

    if not (State.AutoFarm or State.AutoRaid) then return end
    pcall(function()
        local range = State.AutoRaid and RAID_RANGE or FARM_RANGE
        local enemy = GetEnemy(range)
        if enemy then
            FloatOnHead(enemy, dt)
            EquipWeapon()
            DoAttack()
        elseif State.AutoRaid then
            FloatToNext(dt)
        end
    end)
end)

RunService.Stepped:Connect(function()
    if not (State.AutoFarm or State.AutoRaid) then return end
    pcall(function()
        local c = Char()
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end)

task.spawn(function()
    local was = false
    while true do
        task.wait(0.4)
        local now = State.AutoFarm or State.AutoRaid
        if was and not now then
            pcall(function()
                local hum = Hum()
                if hum then
                    hum.AutoRotate = true
                    hum.WalkSpeed = State.Speed and State.WalkSpeed or 16
                    hum.JumpPower = 50
                end
            end)
        end
        if State.AutoRaid and not was then visited = {} end
        was = now
    end
end)

task.spawn(function()
    while true do
        task.wait(2)
        if State.ESP then RefreshESP() end
    end
end)

