end)

local State = {
    AutoFarm = false,
    AutoRaid = false,
    FastAttack = false,
    Speed = false,
    ESP = false,
    WalkSpeed = 120,
    SelectedWeapon = "None",
}

local HEAD_HEIGHT = 6
local HITBOX = 280
local FARM_RANGE = 20000
local RAID_RANGE = 50000
local AC = nil
local visited = {}
local waterPart = nil

local function Char() return LP.Character end
local function Hum()
    local c = Char()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function HRP()
    local c = Char()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function combatOn()
    return State.AutoFarm or State.AutoRaid or State.FastAttack
end

local function EquipWeapon()
    pcall(function()
        local char, hum = Char(), Hum()
        if not char or not hum then return end
        if char:FindFirstChildOfClass("Tool") then return end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        if State.SelectedWeapon == "None" then
        else
            local t = bag:FindFirstChild(State.SelectedWeapon)
            if t and t:IsA("Tool") then
                hum:EquipTool(t)
                return
            end
        end
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                local n = string.lower(t.Name)
                if not string.find(n, "fruit", 1, true) and not string.find(n, "gum", 1, true) then
                    hum:EquipTool(t)
                    return
                end
            end
        end
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                hum:EquipTool(t)
                return
            end
        end
    end)
end

local function LoadCombat()
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        if not ps then return end
        local cf = ps:FindFirstChild("CombatFramework")
        if cf then AC = require(cf) end
    end)
    pcall(function()
        if AC and AC.activeController then return end
        if type(getreg) == "function" then
            for _, v in pairs(getreg()) do
                if type(v) == "table" and rawget(v, "activeController") then
                    AC = v
                    break
                end
            end
        end
    end)
end

LoadCombat()
task.spawn(function()
    for _ = 1, 25 do
        if AC and AC.activeController then break end
        LoadCombat()
        task.wait(0.5)
    end
end)
LP.CharacterAdded:Connect(function()
    task.wait(1)
    AC = nil
    LoadCombat()
end)

local function KillShake()
    pcall(function()
        local util = RS:FindFirstChild("Util")
        if util and util:FindFirstChild("CameraShaker") then
            local m = require(util.CameraShaker)
            if m and m.Stop then m:Stop() end
        end
    end)
end

-- ตีอัตโนมัติ (ไม่ขยาย tool — ขยายแล้วมักตีไม่เข้า)
local lastClick = 0
local function DoAttack()
    KillShake()

    pcall(function()
        if not AC then LoadCombat() end
        local c = AC and AC.activeController
        if c then
            c.timeToNextAttack = 0
            c.attacking = false
            c.blocking = false
            c.hitboxMagnitude = HITBOX
            if type(c.increment) == "number" then c.increment = 3 end
            if type(c.attack) == "function" then
                c:attack()
            end
        end
    end)

    pcall(function()
        local tool = Char() and Char():FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end)

    -- คลิกไม่ถี่เกิน (กันค้าง)
    local now = tick()
    if now - lastClick > 0.04 then
        lastClick = now
        pcall(function()
            VU:CaptureController()
            VU:Button1Down(Vector2.new(0, 0))
            task.delay(0.02, function()
                pcall(function() VU:Button1Up(Vector2.new(0, 0)) end)
            end)
        end)
    end
end

local function isPlayerChar(model)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then return true end
    end
    return false
end

local function GetEnemy(range)
    local h = HRP()
    if not h then return nil end
    local best, bd = nil, range or FARM_RANGE
    local function check(m)
        if not m or not m:IsA("Model") or isPlayerChar(m) then return end
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hu = m:FindFirstChildOfClass("Humanoid")
        if mh and hu and hu.Health > 0 then
            local d = (h.Position - mh.Position).Magnitude
            if d < bd then best, bd = m, d end
        end
    end
    local en = workspace:FindFirstChild("Enemies")
    if en then
        for _, m in ipairs(en:GetChildren()) do check(m) end
    end
    if not best then
        for _, m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") then check(m) end
        end
    end
    return best
end

-- ลอยเหนือหัว + หันหน้าไปทางมอน (ไม่ก้มสุด — ตีเข้ากว่า)
local function FloatOnHead(enemy, dt)
    local h = HRP()
    if not h or not enemy then return end
    local eh = enemy:FindFirstChild("HumanoidRootPart")
    if not eh then return end

    local goal = eh.Position + Vector3.new(0, HEAD_HEIGHT, 0)
    local cur = h.Position
    local dist = (goal - cur).Magnitude
    local a = math.clamp((dt or 0.016) * 22, 0.12, 0.5)
    local np = dist > 50 and goal or cur:Lerp(goal, a)

    -- หันไปที่มอน เล็กน้อยลง
    local look = eh.Position + Vector3.new(0, 2, 0)
    h.CFrame = CFrame.lookAt(np, look)

    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
    local hum = Hum()
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
    end
end

local function GetIslands()
    local list = {}
    local function add(obj)
        if not obj then return end
        local part = obj:IsA("BasePart") and obj
            or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)))
        if not part then return end
        local n = string.lower(obj.Name)
        if string.find(n, "island", 1, true) or string.find(n, "stage", 1, true) or string.find(n, "platform", 1, true) then
            table.insert(list, part)
        end
    end
    for _, o in ipairs(workspace:GetChildren()) do
        add(o)
        if o:IsA("Folder") or o:IsA("Model") then
            for _, ch in ipairs(o:GetChildren()) do add(ch) end
        end
    end
    return list
end

local function FloatToNext(dt)
    local h = HRP()
    if not h then return end
    local islands = GetIslands()
    if #islands == 0 then return end
    local best, score = nil, -1
    for _, p in ipairs(islands) do
        local d = (h.Position - p.Position).Magnitude
        local key = math.floor(p.Position.X / 60) .. "_" .. math.floor(p.Position.Z / 60)
        if d > 40 and d < 12000 and not visited[key] then
            local s = d < 4000 and d or 4000
            if s > score then score, best = s, p end
        end
    end
    if not best then
        visited = {}
        local far, fd = nil, 0
        for _, p in ipairs(islands) do
            local d = (h.Position - p.Position).Magnitude
            if d > fd and d > 50 then far, fd = p, d end
        end
        best = far
    end
    if not best then return end
    local key = math.floor(best.Position.X / 60) .. "_" .. math.floor(best.Position.Z / 60)
    local goal = best.Position + Vector3.new(0, 8, 0)
    local cur = h.Position
    local dist = (goal - cur).Magnitude
    if dist < 14 then
        visited[key] = true
        h.CFrame = CFrame.new(goal)
        return
    end
    local step = math.min(dist, 100 * (dt or 0.016))
    if dist > 0.05 then
        h.CFrame = CFrame.new(cur + (goal - cur).Unit * step)
    end
    pcall(function() h.AssemblyLinearVelocity = Vector3.zero end)
end

local function ClearWater()
    if waterPart then pcall(function() waterPart:Destroy() end) waterPart = nil end
end

-- ESP แบบสั้น
local function MakeESP(char, name)
    pcall(function()
        if not char or char:FindFirstChild("DEKUzESP") then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local bb = Instance.new("BillboardGui")
        bb.Name = "DEKUzESP"
        bb.Size = UDim2.new(0, 100, 0, 24)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = hrp
        bb.Parent = char
        local t = Instance.new("TextLabel")
        t.Size = UDim2.new(1, 0, 1, 0)
        t.BackgroundTransparency = 1
        t.Text = name or "?"
        t.TextColor3 = Color3.fromRGB(100, 200, 255)
        t.Font = Enum.Font.GothamBold
        t.TextSize = 12
        t.Parent = bb
        local hl = Instance.new("Highlight")
        hl.Name = "DEKUzHL"
        hl.FillColor = Color3.fromRGB(50, 140, 255)
        hl.OutlineColor = Color3.fromRGB(120, 200, 255)
        hl.FillTransparency = 0.75
        hl.Parent = char
    end)
end

local function ClearAllESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        pcall(function()
            local c = plr.Character
            if not c then return end
            if c:FindFirstChild("DEKUzESP") then c.DEKUzESP:Destroy() end
            if c:FindFirstChild("DEKUzHL") then c.DEKUzHL:Destroy() end
        end)
    end
end

local function RefreshESP()
    if not State.ESP then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then
        else
            if plr.Character then MakeESP(plr.Character, plr.Name) end
        end
    end
end

