local function combatOn()
    return State.AutoFarm or State.AutoRaid or State.FastAttack
end

local function EquipWeapon()
    pcall(function()
        local char = Char()
        local hum = Hum()
        if not char or not hum then return end
        if char:FindFirstChildOfClass("Tool") then return end

        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end

        if State.SelectedWeapon == "None" then
            -- auto
        else
            local t = bag:FindFirstChild(State.SelectedWeapon)
            if t and t:IsA("Tool") then
                hum:EquipTool(t)
                return
            end
        end

        local prefer = {}
        local other = {}
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                local n = string.lower(t.Name)
                if string.find(n, "fruit", 1, true) or string.find(n, "gum", 1, true) then
                    table.insert(other, t)
                else
                    table.insert(prefer, t)
                end
            end
        end
        local pick = prefer[1] or other[1]
        if pick then hum:EquipTool(pick) end
    end)
end

local function LoadCombat()
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        if not ps then return end
        local cf = ps:FindFirstChild("CombatFramework")
        if cf then
            AC = require(cf)
        end
    end)
    pcall(function()
        if AC and AC.activeController then return end
        if type(getreg) == "function" then
            for _, v in pairs(getreg()) do
                if type(v) == "table" then
                    if rawget(v, "activeController") then
                        AC = v
                        break
                    end
                end
            end
        end
    end)
end

