local function KillShake()
    pcall(function()
        local util = RS:FindFirstChild("Util")
        if util then
            local sh = util:FindFirstChild("CameraShaker")
            if sh then
                local mod = require(sh)
                if mod and type(mod.Stop) == "function" then
                    mod:Stop()
                end
            end
        end
    end)
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        if not ps then return end
        local cf = ps:FindFirstChild("CombatFramework")
        if not cf then return end
        local cam = cf:FindFirstChild("CameraShaker")
        if cam then
            local mod = require(cam)
            if mod and mod.CameraShakeInstance then
                mod.CameraShakeInstance.CameraShakeState = {
                    FadingIn = 3,
                    FadingOut = 2,
                    Sustained = 0,
                    Inactive = 1,
                }
            end
        end
    end)
end

local function ExpandTool()
    pcall(function()
        local ch = Char()
        if not ch then return end
        local tool = ch:FindFirstChildOfClass("Tool")
        if not tool then return end
        for _, p in ipairs(tool:GetDescendants()) do
            if p:IsA("BasePart") then
                if p.Size.Magnitude < 30 then
                    p.Size = Vector3.new(12, 12, 12)
                    p.Transparency = 1
                    p.CanCollide = false
                end
            end
        end
    end)
end

local function Attack()
    KillShake()
    ExpandTool()

    pcall(function()
        if not AC then LoadCombat() end
        if AC and AC.activeController then
            local c = AC.activeController
            c.timeToNextAttack = 0
            c.attacking = false
            c.blocking = false
            c.hitboxMagnitude = HITBOX
            if type(c.increment) == "number" then
                c.increment = 4
            end
            if type(c.attack) == "function" then
                c:attack()
            end
        end
    end)

    pcall(function()
        local ch = Char()
        if not ch then return end
        local tool = ch:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
        end
    end)

    pcall(function()
        VU:CaptureController()
        VU:Button1Down(Vector2.new(0, 0))
        task.wait(0.02)
        VU:Button1Up(Vector2.new(0, 0))
    end)
end

local function GetEnemy(range)
    local h = HRP()
    if not h then return nil end
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end

    local best = nil
    local bestDist = range or 5000

    for _, m in ipairs(folder:GetChildren()) do
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hu = m:FindFirstChildOfClass("Humanoid")
        if mh and hu and hu.Health > 0 then
            local d = (h.Position - mh.Position).Magnitude
            if d < bestDist then
                best = m
                bestDist = d
            end
        end
    end
    return best
end

local function FloatOnHead(enemy, dt)
    local h = HRP()
    if not h or not enemy then return end
    local eh = enemy:FindFirstChild("HumanoidRootPart")
    if not eh then return end

    local goal = eh.Position + Vector3.new(0, HEAD_HEIGHT, 0)
    local cur = h.Position
    local dist = (goal - cur).Magnitude
    local alpha = math.clamp((dt or 0.016) * 18, 0.08, 0.4)
    local np = dist > 80 and goal or cur:Lerp(goal, alpha)

    local lookAt = eh.Position + Vector3.new(0, 1, 0)
    h.CFrame = CFrame.lookAt(np, lookAt)

    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)

    local hum = Hum()
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
    end
end

local function GetIslands()
    local list = {}
    local function add(obj)
        if not obj then return end
        local part = nil
        if obj:IsA("BasePart") then
            part = obj
        elseif obj:IsA("Model") then
            part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
        end
        if not part then return end
        local n = string.lower(obj.Name)
        if string.find(n, "island", 1, true)
            or string.find(n, "stage", 1, true)
            or string.find(n, "platform", 1, true) then
            table.insert(list, part)
        end
    end

    for _, o in ipairs(workspace:GetChildren()) do
        add(o)
        if o:IsA("Folder") or o:IsA("Model") then
            for _, ch in ipairs(o:GetChildren()) do
                add(ch)
            end
        end
    end
    return list
end

local function FloatToNext(dt)
    local h = HRP()
    if not h then return end
    local islands = GetIslands()
    if #islands == 0 then return end

    local best = nil
    local score = -1

    for _, p in ipairs(islands) do
        local d = (h.Position - p.Position).Magnitude
        local key = math.floor(p.Position.X / 60) .. "_" .. math.floor(p.Position.Z / 60)
        if d > 40 and d < 8000 and not visited[key] then
            local s = d < 2500 and d or 2500
            if s > score then
                score = s
                best = p
            end
        end
    end

    if not best then
        visited = {}
        local far = nil
        local fd = 0
        for _, p in ipairs(islands) do
            local d = (h.Position - p.Position).Magnitude
            if d > fd and d > 50 then
                far = p
                fd = d
            end
        end
        best = far
    end
    if not best then return end

    local key = math.floor(best.Position.X / 60) .. "_" .. math.floor(best.Position.Z / 60)
    local goal = best.Position + Vector3.new(0, 8, 0)
    local cur = h.Position
    local dist = (goal - cur).Magnitude

    if dist < 14 then
        visited[key] = true
        h.CFrame = CFrame.new(goal)
        pcall(function() h.AssemblyLinearVelocity = Vector3.zero end)
        return
    end

    local step = math.min(dist, 85 * (dt or 0.016))
    if dist > 0.05 then
        h.CFrame = CFrame.new(cur + (goal - cur).Unit * step)
    end
    pcall(function() h.AssemblyLinearVelocity = Vector3.zero end)
end

