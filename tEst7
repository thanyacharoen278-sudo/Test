RunService.Heartbeat:Connect(function(dt)
    if State.Speed and not State.AutoFarm and not State.AutoRaid then
        pcall(function()
            local hum = Hum()
            local h = HRP()
            if not hum or not h then return end
            hum.WalkSpeed = State.WalkSpeed
            if not waterPart or not waterPart.Parent then
                local p = Instance.new("Part")
                p.Name = "DEKUzWater"
                p.Size = Vector3.new(12, 1, 12)
                p.Transparency = 1
                p.Anchored = true
                p.CanCollide = true
                p.Parent = workspace
                waterPart = p
            end
            waterPart.CFrame = CFrame.new(h.Position.X, h.Position.Y - 3.2, h.Position.Z)
        end)
    else
        ClearWater()
    end

    if not (State.AutoFarm or State.AutoRaid) then return end

    pcall(function()
        local range = State.AutoRaid and 8000 or 5000
        local enemy = GetEnemy(range)
        if enemy then
            FloatOnHead(enemy, dt)
            EquipWeapon()
            Attack()
        elseif State.AutoRaid then
            FloatToNext(dt)
        end
    end)
end)

